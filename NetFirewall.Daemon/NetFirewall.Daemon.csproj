<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <!-- Workstation (concurrent) GC: an appliance serves a handful of operators, not
             high-throughput HTTP. Measured on Debian 13 after the same warm-up: Web 222→172 MB,
             daemon 190→153 MB RSS vs Server GC (DATAS). Latency is unaffected at this load. -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>netfirewall-daemon</AssemblyName>
        <RootNamespace>NetFirewall.Daemon</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="11.0.0" />
        <PackageReference Include="Serilog.AspNetCore" Version="11.0.0" />
        <PackageReference Include="Serilog.Settings.Configuration" Version="11.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <PackageReference Include="RepoDb.PostgreSql" Version="1.17.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NetFirewall.ServiceDefaults\NetFirewall.ServiceDefaults.csproj" />
        <ProjectReference Include="..\NetFirewall.Services\NetFirewall.Services.csproj" />
        <ProjectReference Include="..\NetFirewall.Models\NetFirewall.Models.csproj" />
        <ProjectReference Include="..\NetFirewall.Migrations\NetFirewall.Migrations.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\NetFirewall.Services\sql\migrations\*.sql"
              Link="sql\migrations\%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
