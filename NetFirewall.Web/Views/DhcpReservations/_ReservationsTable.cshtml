@model IReadOnlyList<NetFirewall.Models.Dhcp.DhcpMacReservation>
@using NetFirewall.Web.Models.Shared
@{
    var query = ViewBag.Query as string;
    var hasFilter = !string.IsNullOrWhiteSpace(query);
}

@if (Model.Count == 0)
{
    <div class="text-sm py-10 text-center text-surface-fg-muted">
        @if (hasFilter)
        {
            <text>No reservations match &ldquo;<span class="font-mono">@query</span>&rdquo;.</text>
        }
        else
        {
            <text>No reservations yet. Click <span class="font-medium text-surface-fg">Add reservation</span> to permanently bind a MAC address to an IP.</text>
        }
    </div>
}
else
{
    <div class="px-5 pb-2 text-xs text-surface-fg-muted">
        <span class="font-medium text-surface-fg">@Model.Count</span> reservation@(Model.Count == 1 ? "" : "s")
    </div>
    <div class="overflow-x-auto -mx-5">
        <table class="min-w-full text-sm">
            <thead>
                <tr class="text-left text-[11px] uppercase tracking-wider text-surface-fg-muted border-b border-surface-border">
                    <th class="pl-5 pr-2 py-1.5 font-medium">Reservation</th>
                    <th class="px-2 py-1.5 font-medium hidden md:table-cell">Description</th>
                    <th class="pl-2 pr-5 py-1.5 font-medium text-right w-28">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y border-surface-border">
                @foreach (var r in Model.OrderBy(x => x.ReservedIp?.ToString()))
                {
                    <tr>
                        <td class="pl-5 pr-2 py-2.5">
                            <div class="flex items-center gap-1 flex-wrap">
                                @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "mac", Value = r.MacAddress.ToString(), Title = r.MacAddress.ToString() })
                                @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "ip", Value = r.ReservedIp.ToString() })
                            </div>
                        </td>
                        <td class="px-2 py-2.5 hidden md:table-cell text-xs text-surface-fg-muted">
                            @(r.Description ?? "—")
                        </td>
                        <td class="pl-2 pr-5 py-2.5 text-right whitespace-nowrap">
                            @await Html.PartialAsync("_RowActions", new RowActionsViewModel
                            {
                                EditUrl = $"/Dhcp/Reservations/edit/{r.Id}",
                                EditDrawerTitle = "Edit reservation",
                                DeleteUrl = $"/Dhcp/Reservations/delete/{r.Id}",
                                DeleteDialogTitle = "Delete reservation?",
                                DeleteMessage = $"Delete reservation for {r.MacAddress} → {r.ReservedIp}? The IP will rejoin the general pool."
                            })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
