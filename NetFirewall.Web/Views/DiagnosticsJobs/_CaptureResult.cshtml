@model (Guid JobId, NetFirewall.Models.Diagnostics.CaptureResult Capture)
@using NetFirewall.Web.Models.Diagnostics
@{
    var c = Model.Capture;
}
@if (c.Error is not null)
{
    <p class="text-sm text-feedback-danger-fg">@c.Error</p>
}
@if (c.SizeBytes > 0)
{
    <div class="flex flex-wrap items-center gap-3 mb-3">
        <span class="text-sm">@c.PacketsCaptured packet(s) · @DiagUi.Bytes(c.SizeBytes)</span>
        @if (c.ReachedLimit) { <span class="badge badge-warning">packet limit reached</span> }
        <a href="/Diagnostics/Jobs/@Model.JobId/download" class="btn btn-primary text-xs ml-auto"
           @@click.prevent="$store.elevation.navigate($el.href)">Download .pcap</a>
        <form hx-post="/Diagnostics/Jobs/@Model.JobId/delete" hx-swap="none" hx-trigger="confirmed-delete">
            @Html.AntiForgeryToken()
            <button type="button" class="btn btn-ghost text-xs text-feedback-danger-fg"
                    @@click.prevent="(async () => {
                        const ok = await $store.confirm.ask({
                            title: 'Delete this capture?',
                            message: 'The .pcap is removed from the firewall. Download it first if you still need it.',
                            confirmLabel: 'Delete', level: 'danger' });
                        if (ok) htmx.trigger($el.closest('form'), 'confirmed-delete');
                    })()">Delete</button>
        </form>
    </div>
    @if (c.Preview.Count > 0)
    {
        <pre class="text-xs p-3 rounded-lg overflow-auto max-h-96 font-mono"
             style="background-color: var(--surface-muted); color: var(--surface-fg); border: 1px solid var(--surface-border);"><code>@string.Join('\n', c.Preview)</code></pre>
        <p class="text-xs mt-1 text-surface-fg-muted">First @c.Preview.Count decoded line(s). The download holds the full capture.</p>
    }
}
else if (c.Error is null)
{
    <p class="text-sm text-surface-fg-muted">Nothing was captured — no packet matched the filter on that interface.</p>
}
