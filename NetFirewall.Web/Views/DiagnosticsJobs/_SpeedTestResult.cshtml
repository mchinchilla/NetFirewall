@model NetFirewall.Models.Diagnostics.SpeedTestResult
@using NetFirewall.Web.Models.Diagnostics
@{
    var r = Model;
}
@* Used live (inside the polling job panel) and from History; both pass the bare result. *@
<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
    <div class="kpi"><span class="text-xs text-surface-fg-muted">Average</span><span class="kpi-value">@r.AvgMbps.ToString("0.#")<span class="text-base text-surface-fg-muted"> Mbps</span></span></div>
    <div class="kpi"><span class="text-xs text-surface-fg-muted">Peak second</span><span class="kpi-value">@r.PeakMbps.ToString("0.#")<span class="text-base text-surface-fg-muted"> Mbps</span></span></div>
    <div class="kpi"><span class="text-xs text-surface-fg-muted">First byte</span><span class="kpi-value">@(r.TtfbMs is { } t ? t.ToString("0") : "—")<span class="text-base text-surface-fg-muted"> ms</span></span></div>
    <div class="kpi"><span class="text-xs text-surface-fg-muted">Downloaded</span><span class="kpi-value text-xl">@DiagUi.Bytes(r.Bytes)</span><span class="text-xs text-surface-fg-muted">in @r.Seconds.ToString("0.#") s · @r.Streams stream(s)</span></div>
</div>

@await Html.PartialAsync("~/Views/DiagnosticsJobs/_SpeedTestChart.cshtml", r.SamplesMbps)

<p class="text-xs font-mono text-surface-fg-muted mt-3">
    via @r.Wan (mark 0x@(r.Fwmark.ToString("x"))) · @r.Source · @r.Url
</p>

@if (r.OtherTrafficMbps is { } other)
{
    <p class="text-sm mt-2 @(other >= 1 ? "text-feedback-warning-fg" : "text-surface-fg-muted")">
        Other traffic on @r.Wan during the test: ~@other.ToString("0.#") Mbps.
        @if (other >= 1)
        {
            <text>The link was shared, so the result is the capacity left over, not the line rate.</text>
        }
    </p>
}
@if (r.ReachedByteCap)
{
    <p class="text-sm mt-2 text-surface-fg-muted">Stopped at the size cap before the time ran out — raise the cap for a longer sample.</p>
}
@if (r.Warning is not null)
{
    <p class="text-sm mt-2 text-feedback-warning-fg">@r.Warning</p>
}
@if (r.Error is not null)
{
    <p class="text-sm mt-2 text-feedback-danger-fg">@r.Error</p>
}

@if (r.File is { } f)
{
    <div class="mt-4 pt-3 border-t border-surface-border space-y-2">
        <p class="text-sm">
            Kept <span class="font-mono">@f.FileName</span> · @DiagUi.Bytes(f.SizeBytes)
            @if (!f.Complete) { <span class="badge badge-muted">partial copy</span> }
            @if (f.DiskWriteMbps is { } disk) { <span class="text-xs text-surface-fg-muted">· disk wrote at @disk.ToString("0.#") Mbps</span> }
        </p>
        @if (f.DiskLimited)
        {
            <p class="text-xs text-feedback-warning-fg">Writing to disk took most of that connection's time — the firewall's disk may have held the number down. Re-run without keeping the file to measure the WAN alone.</p>
        }
        @await Html.PartialAsync("~/Views/DiagnosticsJobs/_SpeedTestFileActions.cshtml", f)
    </div>
}
