@model NetFirewall.Web.Models.Dhcp.BlockedMacFormViewModel
@using NetFirewall.Web.Models

<form id="blocked-mac-form"
      hx-post="/Dhcp/Access/blocked/save"
      hx-target="this" hx-swap="outerHTML">
    @Html.AntiForgeryToken()
    @if (Model.Id.HasValue)
    {
        <input type="hidden" name="Id" value="@Model.Id" />
    }

    <div class="space-y-4">
        @await Html.PartialAsync("_FormField", new FormFieldViewModel {
            Name = nameof(Model.MacAddress), Label = "MAC address", Required = true, Value = Model.MacAddress,
            Placeholder = "AA:BB:CC:DD:EE:FF", MaxLength = 17,
            Pattern = @"^([0-9A-Fa-f]{2}([:-])){5}[0-9A-Fa-f]{2}$",
            Help = "Separator colon (:) or dash (-). Its current lease is released when you save."
        })

        @await Html.PartialAsync("_FormField", new FormFieldViewModel {
            Name = nameof(Model.Reason), Label = "Reason (optional)", Kind = FormFieldKind.Textarea,
            Value = Model.Reason, MaxLength = 255,
            Placeholder = "unknown device, lost phone, …"
        })
    </div>

    <div class="mt-6 pt-4 border-t flex items-center justify-end gap-2 border-surface-border">
        <button type="button" class="btn btn-ghost" @@click="$store.drawer.close()">Cancel</button>
        <button type="submit" class="btn btn-primary">@(Model.Id.HasValue ? "Save changes" : "Block device")</button>
    </div>
</form>
