@{
    var subnet = (NetFirewall.Models.Dhcp.DhcpSubnet)ViewBag.Subnet;
    ViewData["Title"] = $"Pools — {subnet.Name}";
    Layout = "_Layout";
}

<div x-data="{ hideDisabled: false }">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-4"
         style="animation: var(--animate-slide-up);">
        <div>
            <p class="text-xs uppercase tracking-wider font-semibold text-surface-fg-muted">
                <a href="/Dhcp/Subnets" class="hover:underline text-accent">DHCP · Subnets</a>
                <span class="text-surface-fg-muted"> / </span>
                @subnet.Name
            </p>
            <h1 class="text-2xl font-semibold tracking-tight">Pools</h1>
            <p class="text-sm mt-1 max-w-2xl text-surface-fg-muted">
                Address ranges DHCP can hand out from <span class="font-mono">@subnet.Network</span>.
                Multiple pools per subnet support priority and class-based steering.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-primary"
                    hx-get="/Dhcp/Subnets/@subnet.Id/Pools/edit"
                    hx-target="#drawer-body" hx-swap="innerHTML"
                    @@click="$store.drawer.openRaw('Add pool')">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                Add pool
            </button>
        </div>
    </div>

    <div class="flex flex-wrap items-center gap-2 mb-4"
         style="animation: var(--animate-slide-up); animation-delay: 40ms;">
        @await Html.PartialAsync("_TableSearch", new TableSearchModel { TableId = "pools-table", Placeholder = "Filter by name, range…", ClientSide = true })
        <label class="text-xs flex items-center gap-2 cursor-pointer select-none text-surface-fg-muted">
            <input type="checkbox" class="rounded" x-model="hideDisabled" />
            Hide disabled
        </label>
    </div>

    <section class="card" style="animation: var(--animate-slide-up); animation-delay: 80ms;">
        <div id="pools-table"
             :class="{ 'hide-disabled-rules': hideDisabled }"
             hx-get="/Dhcp/Subnets/@subnet.Id/Pools/table"
             hx-trigger="load, refreshPools from:body"
             hx-swap="innerHTML">
            @await Html.PartialAsync("_LoadingOverlay", new LoadingOverlayModel { Variant = LoadingOverlayVariant.Placeholder })
        </div>
    </section>
</div>
