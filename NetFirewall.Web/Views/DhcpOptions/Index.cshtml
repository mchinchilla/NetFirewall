@{
    ViewData["Title"] = "DHCP — Custom options";
    Layout = "_Layout";
}
<div>
    <div class="flex flex-wrap items-end justify-between gap-3 mb-4" style="animation: var(--animate-slide-up);">
        <div>
            <p class="page-kicker">DHCP</p>
            <h1 class="text-2xl font-semibold tracking-tight">Custom options</h1>
            <p class="text-sm mt-1 max-w-2xl text-surface-fg-muted">
                Settings the subnet fields don't cover — a provisioning server for IP phones, a controller for access
                points, a proxy auto-config URL. Give one to every client, a subnet, a client class or a single
                reserved device; the most specific one wins. Router, DNS and lease times stay on the subnet.
            </p>
        </div>
        <button type="button" class="btn btn-primary"
                hx-get="/Dhcp/Options/edit" hx-target="#drawer-body" hx-swap="innerHTML"
                @@click="$store.drawer.openRaw('Add custom option')">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
            Add option
        </button>
    </div>

    <section style="animation: var(--animate-slide-up); animation-delay: 60ms;">
        @await Html.PartialAsync("_Grid", new GridFrameViewModel
        {
            GridId = NetFirewall.Web.Grids.Dhcp.DhcpCustomOptionsGrid.Id,
            Title = "DHCP custom options",
            DefaultQuery = NetFirewall.Web.Grids.Dhcp.DhcpCustomOptionsGrid.DefaultQuery,
            RefreshOn = ["refreshDhcpOptions"]
        })
    </section>
</div>
