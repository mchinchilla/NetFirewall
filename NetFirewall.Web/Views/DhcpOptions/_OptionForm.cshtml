@model NetFirewall.Web.Models.Dhcp.DhcpOptionFormPageViewModel
@using NetFirewall.Web.Models
@{
    var f = Model.Form;
}
@*
    Presets fill code + format + name for the options people actually set; anything else can be
    typed. The value is validated client-side by format (HTML pattern) and encoded/validated again
    by the server, which refuses protocol-owned codes (53, 54, 51, …).
*@
<form hx-post="/Dhcp/Options/save" hx-swap="none" class="space-y-4"
      x-data="{
          code: @f.Code, format: '@f.Format', name: @System.Text.Json.JsonSerializer.Serialize(f.Name ?? ""),
          presets: {
              '66':  ['string',  'TFTP server name (IP phones)'],
              '150': ['ip_list', 'TFTP server address (Cisco phones)'],
              '43':  ['hex',     'Vendor-specific information'],
              '42':  ['ip_list', 'NTP servers'],
              '138': ['ip_list', 'CAPWAP access-point controllers'],
              '160': ['string',  'Captive portal URL (RFC 8910)'],
              '252': ['string',  'Proxy auto-config (WPAD) URL'],
              '119': ['hex',     'Domain search (encoded)']
          },
          pick(c) { const p = this.presets[c]; if (!p) return; this.code = +c; this.format = p[0]; this.name = p[1]; },
          get pattern() {
              return ({ ip: '^\\d{1,3}(\\.\\d{1,3}){3}$', ip_list: '^\\d{1,3}(\\.\\d{1,3}){3}([ ,]+\\d{1,3}(\\.\\d{1,3}){3})*$',
                        uint8: '^\\d{1,3}$', uint16: '^\\d{1,5}$', uint32: '^\\d{1,10}$',
                        bool: '^(true|false|1|0|yes|no|on|off)$', hex: '^[0-9a-fA-F:\\- ]+$' })[this.format] || '.+';
          },
          get hint() {
              return ({ ip: 'One IPv4 address', ip_list: 'IPv4 addresses, comma separated', string: 'Text',
                        uint8: '0–255', uint16: '0–65535', uint32: '0–4294967295', bool: 'true / false',
                        hex: 'Raw bytes in hex, e.g. 06 01 08 ff' })[this.format];
          }
      }">
    @Html.AntiForgeryToken()
    @if (f.Id.HasValue) { <input type="hidden" name="Id" value="@f.Id" /> }

    @if (!f.Id.HasValue)
    {
        <div class="space-y-1.5">
            <span class="block text-xs font-medium text-surface-fg">Common options</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var (code, label) in new[] { ("66", "66 · Phone TFTP name"), ("150", "150 · Cisco TFTP"), ("43", "43 · Vendor"), ("138", "138 · AP controller"), ("42", "42 · NTP"), ("160", "160 · Captive portal"), ("252", "252 · WPAD") })
                {
                    <button type="button" class="badge" :class="code === @code ? 'badge-accent' : 'badge-muted'" @@click="pick('@code')">@label</button>
                }
            </div>
        </div>
    }

    <div class="grid grid-cols-3 gap-3">
        <div class="space-y-1.5">
            <label for="f-Code" class="block text-xs font-medium text-surface-fg">Option code <span class="text-feedback-danger-fg">*</span></label>
            <input id="f-Code" name="Code" type="number" min="1" max="254" required class="input font-mono" x-model.number="code" />
        </div>
        <div class="space-y-1.5 col-span-2">
            <label for="f-Format" class="block text-xs font-medium text-surface-fg">Value format <span class="text-feedback-danger-fg">*</span></label>
            <select id="f-Format" name="Format" class="input" x-model="format">
                <option value="string">Text</option>
                <option value="ip">IPv4 address</option>
                <option value="ip_list">IPv4 address list</option>
                <option value="uint8">Number (1 byte)</option>
                <option value="uint16">Number (2 bytes)</option>
                <option value="uint32">Number (4 bytes)</option>
                <option value="bool">Yes / no</option>
                <option value="hex">Raw hex</option>
            </select>
        </div>
    </div>

    <div class="space-y-1.5">
        <label for="f-Value" class="block text-xs font-medium text-surface-fg">Value <span class="text-feedback-danger-fg">*</span></label>
        <input id="f-Value" name="Value" required maxlength="1024" class="input font-mono" value="@f.Value"
               :pattern="pattern" :title="hint" :placeholder="hint" autocomplete="off" />
        <p class="text-xs text-surface-fg-muted" x-text="hint"></p>
    </div>

    <div class="space-y-1.5">
        <label for="f-Name" class="block text-xs font-medium text-surface-fg">Label (optional)</label>
        <input id="f-Name" name="Name" maxlength="100" class="input" x-model="name" />
    </div>

    <div class="space-y-1.5">
        <label for="f-ScopeType" class="block text-xs font-medium text-surface-fg">Applies to <span class="text-feedback-danger-fg">*</span></label>
        <select id="f-ScopeType" name="ScopeType" class="input"
                hx-get="/Dhcp/Options/targets" hx-target="#option-scope-targets" hx-swap="innerHTML" hx-trigger="change"
                hx-vals='{"selected": "@f.ScopeId"}'>
            <option value="global" selected="@(f.ScopeType == "global")">Every client</option>
            <option value="subnet" selected="@(f.ScopeType == "subnet")">A subnet</option>
            <option value="class" selected="@(f.ScopeType == "class")">A client class</option>
            <option value="host" selected="@(f.ScopeType == "host")">One reserved device</option>
        </select>
    </div>
    <div id="option-scope-targets">
        @await Html.PartialAsync("_ScopeTargets", Model)
    </div>

    <div class="pt-4 border-t flex items-center justify-end gap-2 border-surface-border">
        <button type="button" class="btn btn-ghost" @@click="$store.drawer.close()">Cancel</button>
        <button type="submit" class="btn btn-primary">Save option</button>
    </div>
</form>
