@{
    ViewData["Title"] = "DHCP — Leases";
    Layout = "_Layout";
}

<div>
    <div class="flex flex-wrap items-end justify-between gap-3 mb-4"
         style="animation: var(--animate-slide-up);">
        <div>
            <p class="page-kicker">DHCP</p>
            <h1 class="text-2xl font-semibold tracking-tight">Leases</h1>
            <p class="text-sm mt-1 max-w-2xl text-surface-fg-muted">
                Every lease the DHCP server has handed out. Filter, group and expand a row for its timing, reservation and subnet. Refreshes every 30 seconds.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-ghost"
                    hx-post="/Dhcp/Leases/cleanup-expired"
                    hx-trigger="confirmed-cleanup"
                    @@click.prevent="(async () => {
                        const ok = await $store.confirm.ask({
                            title: 'Cleanup expired leases?',
                            message: 'Removes every lease past its end_time from the database. Active leases are NOT touched.',
                            confirmLabel: 'Cleanup',
                            level: 'warning'
                        });
                        if (ok) htmx.trigger($el, 'confirmed-cleanup');
                    })()">Cleanup expired</button>
        </div>
    </div>

    <section style="animation: var(--animate-slide-up); animation-delay: 60ms;">
        @await Html.PartialAsync("_Grid", new GridFrameViewModel
        {
            GridId = NetFirewall.Web.Grids.Dhcp.DhcpLeasesGrid.Id,
            Title = "DHCP leases",
            DefaultQuery = NetFirewall.Web.Grids.Dhcp.DhcpLeasesGrid.DefaultQuery,
            RefreshOn = ["refreshLeases"],
            RefreshEverySeconds = 30
        })
    </section>
</div>
