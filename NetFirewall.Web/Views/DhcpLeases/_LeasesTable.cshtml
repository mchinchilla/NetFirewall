@model IReadOnlyList<NetFirewall.Models.Dhcp.DhcpLease>
@using NetFirewall.Web.Models.Shared
@{
    var includeExpired = (bool)(ViewBag.IncludeExpired ?? false);
    var query = ViewBag.Query as string;
    var hasFilter = !string.IsNullOrWhiteSpace(query);
    var now = DateTime.UtcNow;
}

@if (Model.Count == 0)
{
    <div class="text-sm py-10 text-center text-surface-fg-muted">
        @if (hasFilter)
        {
            <text>No @(includeExpired ? "leases" : "active leases") match &ldquo;<span class="font-mono">@query</span>&rdquo;.</text>
        }
        else
        {
            <text>No @(includeExpired ? "leases on record" : "active leases"). Plug something in and this page will pick it up.</text>
        }
    </div>
}
else
{
    var grouped = Model
        .OrderBy(x => x.IpAddress?.ToString())
        .GroupBy(l => l.EndTime <= now ? "Expired" : "Active");
    var active = Model.Count(l => l.EndTime > now);
    var expired = Model.Count - active;
    <div class="px-5 pb-2 text-xs text-surface-fg-muted">
        <span class="font-medium text-surface-fg">@active</span> active
        @if (expired > 0) { <span>· @expired expired</span> }
        <span>· @Model.Count total</span>
    </div>
    <div class="overflow-x-auto -mx-5">
        <table class="min-w-full text-sm">
            @foreach (var group in grouped.OrderBy(g => g.Key == "Active" ? 0 : 1))
            {
                <thead>
                    <tr>
                        <th colspan="5" class="px-5 pt-5 pb-2 text-left">
                            <div class="flex items-baseline gap-2 flex-wrap">
                                <span class="text-sm font-semibold uppercase tracking-wide text-surface-fg">@group.Key</span>
                                <span class="text-xs font-normal text-surface-fg-muted">· @group.Count()</span>
                            </div>
                        </th>
                    </tr>
                    <tr class="text-left text-[11px] uppercase tracking-wider text-surface-fg-muted border-b border-surface-border">
                        <th class="pl-5 pr-2 py-1.5 font-medium">Lease</th>
                        <th class="px-2 py-1.5 font-medium hidden md:table-cell">Host</th>
                        <th class="px-2 py-1.5 font-medium hidden lg:table-cell">Expires</th>
                        <th class="px-2 py-1.5 font-medium w-20">Status</th>
                        <th class="pl-2 pr-5 py-1.5 font-medium text-right w-28">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y border-surface-border">
                    @foreach (var l in group)
                    {
                        var expiredRow = l.EndTime <= now;
                        var remaining = l.EndTime - now;
                        <tr>
                            <td class="pl-5 pr-2 py-2.5">
                                <div class="flex items-center gap-1 flex-wrap">
                                    @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "ip", Value = l.IpAddress.ToString() })
                                    @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "mac", Value = l.MacAddress.ToString(), Title = l.MacAddress.ToString() })
                                </div>
                            </td>
                            <td class="px-2 py-2.5 hidden md:table-cell text-xs text-surface-fg">@(l.Hostname ?? "—")</td>
                            <td class="px-2 py-2.5 hidden lg:table-cell text-xs text-surface-fg-muted">
                                @l.EndTime.ToLocalTime().ToString("g")
                                @if (!expiredRow && remaining.TotalHours < 24)
                                {
                                    <span class="ml-1 text-[10px] text-feedback-warning-fg">(in @remaining.Hours h @remaining.Minutes m)</span>
                                }
                            </td>
                            <td class="px-2 py-2.5 whitespace-nowrap">
                                @if (expiredRow)
                                {
                                    <span class="badge badge-muted">Expired</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                            </td>
                            <td class="pl-2 pr-5 py-2.5 text-right whitespace-nowrap">
                                @if (!expiredRow)
                                {
                                    var msg = $"Release lease {l.IpAddress} (MAC {l.MacAddress})? The client will need to renew via DHCPREQUEST.";
                                    <button type="button" class="btn btn-ghost text-xs text-feedback-danger-fg"
                                            hx-post="/Dhcp/Leases/release/@l.Id"
                                            hx-trigger="confirmed-rel"
                                            data-msg="@msg"
                                            @@click.prevent="(async () => {
                                                const ok = await $store.confirm.ask({
                                                    title: 'Release lease?',
                                                    message: $event.currentTarget.dataset.msg,
                                                    confirmLabel: 'Release',
                                                    level: 'warning'
                                                });
                                                if (ok) htmx.trigger($el, 'confirmed-rel');
                                            })()">Release</button>
                                }
                                else
                                {
                                    <span class="text-xs text-surface-fg-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            }
        </table>
    </div>
}
