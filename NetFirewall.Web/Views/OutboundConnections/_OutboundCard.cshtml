@model NetFirewall.Web.Models.Vpn.OutboundConnectionCard
@{
    var name = Model.Interface.Name;
}
<section class="card flex flex-col" id="conn-@name" style="animation: var(--animate-slide-up); animation-delay: 60ms;"
         x-data="{ egress: false }">
    <header class="flex flex-wrap items-start justify-between gap-3 mb-3">
        <div class="min-w-0">
            <div class="flex items-center gap-2">
                <h2 class="text-base font-semibold truncate">@Model.Title</h2>
                <span class="badge @(Model.IsProvider ? "badge-accent" : "badge-info")">@Model.KindLabel</span>
                @if (!Model.Interface.Enabled) { <span class="badge badge-muted">Disabled</span> }
            </div>
            <p class="text-xs mt-1 font-mono text-surface-fg-muted break-all">
                @name &nbsp;@Model.Interface.AddressCidr&nbsp; → &nbsp;@(Model.Remote?.Endpoint ?? "no endpoint")
            </p>
        </div>
        @await Html.PartialAsync("_InterfaceActions", Model.Interface)
    </header>

    <div hx-get="/Vpn/WireGuard/status?compact=true&iface=@Uri.EscapeDataString(name)"
         hx-trigger="load, every 15s, refreshWireGuard from:body" hx-swap="innerHTML">
        @await Html.PartialAsync("_LoadingOverlay", new LoadingOverlayModel { Variant = LoadingOverlayVariant.Placeholder })
    </div>

    <dl class="grid grid-cols-2 gap-x-4 gap-y-2 mt-4 text-xs">
        <div>
            <dt class="text-surface-fg-muted">@(Model.IsProvider ? "Routes" : "Remote networks")</dt>
            <dd class="font-mono mt-0.5 break-all">@(Model.IsProvider ? "Everything, for the devices you choose" : string.Join(", ", Model.Remote?.AllowedSubnets ?? []))</dd>
        </div>
        <div>
            <dt class="text-surface-fg-muted">This side's key</dt>
            <dd class="font-mono mt-0.5 truncate" title="@Model.Interface.PublicKey">@Model.Interface.PublicKey</dd>
        </div>
    </dl>

    @if (Model.IsProvider)
    {
        <div class="mt-4 pt-3 border-t border-surface-border">
            <button type="button" class="text-sm font-medium text-accent" @@click="egress = !egress" :aria-expanded="egress.toString()">
                <span x-text="egress ? 'Hide devices' : 'Choose devices that use this connection'">Choose devices that use this connection</span>
            </button>
            <div x-show="egress" x-cloak class="mt-3" hx-get="/Vpn/WireGuard/Egress/panel?iface=@Uri.EscapeDataString(name)"
                     hx-trigger="intersect once, refreshWireGuard from:body" hx-swap="innerHTML">
                    @await Html.PartialAsync("_LoadingOverlay", new LoadingOverlayModel { Variant = LoadingOverlayVariant.Placeholder })
                </div>
        </div>
    }
</section>
