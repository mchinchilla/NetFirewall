@model NetFirewall.Web.Models.Vpn.SharedInterfaceTunnels
@*
    Pre-split layout: upstream tunnels that still live on the remote-access server's interface
    (one wg0 doing both jobs). They keep working as they are; they're shown here so the outbound
    picture is complete.
*@
<section class="card mt-4" style="animation: var(--animate-slide-up); animation-delay: 120ms;" x-data="{ egress: false }">
    <header class="flex flex-wrap items-start justify-between gap-3 mb-3">
        <div>
            <div class="flex items-center gap-2">
                <h2 class="text-base font-semibold">Provider tunnels on @Model.Interface.Name</h2>
                <span class="badge badge-warning">Shares @Model.Interface.Name</span>
            </div>
            <p class="text-xs mt-1 text-surface-fg-muted max-w-2xl">
                These upstream tunnels run on the same interface as the VPN server, so stopping or applying one affects
                the other. They keep working as they are; new connections get an interface of their own.
            </p>
        </div>
        <button type="button" class="btn btn-ghost text-xs"
                hx-get="/Vpn/Outbound/split/@Uri.EscapeDataString(Model.Interface.Name)" hx-target="#drawer-body" hx-swap="innerHTML"
                @@click="$store.drawer.openRaw('Split @Model.Interface.Name')">Split into two interfaces…</button>
    </header>
    <ul class="divide-y divide-surface-border text-sm">
        @foreach (var p in Model.Tunnels)
        {
            <li class="py-2 flex flex-wrap items-center justify-between gap-2">
                <span class="font-medium">@p.Name</span>
                <span class="font-mono text-xs text-surface-fg-muted">@(p.Endpoint ?? "—")</span>
            </li>
        }
    </ul>
    <div class="mt-3 pt-3 border-t border-surface-border">
        <button type="button" class="text-sm font-medium text-accent" @@click="egress = !egress" :aria-expanded="egress.toString()">
            <span x-text="egress ? 'Hide devices' : 'Choose devices that use these tunnels'">Choose devices that use these tunnels</span>
        </button>
        <div x-show="egress" x-cloak class="mt-3" hx-get="/Vpn/WireGuard/Egress/panel?iface=@Uri.EscapeDataString(Model.Interface.Name)"
                 hx-trigger="intersect once, refreshWireGuard from:body" hx-swap="innerHTML">
                @await Html.PartialAsync("_LoadingOverlay", new LoadingOverlayModel { Variant = LoadingOverlayVariant.Placeholder })
            </div>
    </div>
</section>
