@model IReadOnlyList<NetFirewall.Models.Network.NetworkService>
@using NetFirewall.Web.Models.Shared

@if (Model.Count == 0)
{
    <div class="text-sm py-10 text-center text-surface-fg-muted">
        No services in this view. Click <span class="font-medium text-surface-fg">Add service</span> to create one.
    </div>
}
else
{
    var grouped = Model
        .OrderBy(s => s.Name)
        .GroupBy(s => string.IsNullOrWhiteSpace(s.Category) ? "Uncategorized" : s.Category!);
    <div class="px-5 pb-2 text-xs text-surface-fg-muted">
        <span class="font-medium text-surface-fg">@Model.Count</span> service@(Model.Count == 1 ? "" : "s")
    </div>
    <div class="overflow-x-auto -mx-5">
        <table class="min-w-full text-sm">
            @foreach (var group in grouped)
            {
                <thead>
                    <tr>
                        <th colspan="4" class="px-5 pt-5 pb-2 text-left">
                            <div class="flex items-baseline gap-2 flex-wrap">
                                <span class="text-sm font-semibold uppercase tracking-wide text-surface-fg">@group.Key</span>
                                <span class="text-xs font-normal text-surface-fg-muted">· @group.Count()</span>
                            </div>
                        </th>
                    </tr>
                    <tr class="text-left text-[11px] uppercase tracking-wider text-surface-fg-muted border-b border-surface-border">
                        <th class="pl-5 pr-2 py-1.5 font-medium">Name</th>
                        <th class="px-2 py-1.5 font-medium">Port</th>
                        <th class="px-2 py-1.5 font-medium hidden lg:table-cell">Description</th>
                        <th class="pl-2 pr-5 py-1.5 font-medium text-right w-28">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y border-surface-border">
                    @foreach (var s in group)
                    {
                        var protoCls = s.Protocol switch
                        {
                            "tcp"     => "badge-accent",
                            "udp"     => "badge-info",
                            "tcp+udp" => "badge-warning",
                            "icmp"    => "badge-success",
                            _         => "badge-muted"
                        };
                        <tr>
                            <td class="pl-5 pr-2 py-2.5">
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    <span class="font-mono font-medium text-surface-fg">@s.Name</span>
                                    <span class="badge @protoCls uppercase tracking-wide">@s.Protocol</span>
                                    @if (s.IsBuiltin)
                                    {
                                        <span class="badge badge-muted">builtin</span>
                                    }
                                    @if (s.Members is { Count: > 0 })
                                    {
                                        <span class="badge badge-accent">group · @s.Members.Count</span>
                                    }
                                </div>
                            </td>
                            <td class="px-2 py-2.5">
                                @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "port", Value = s.PortString })
                            </td>
                            <td class="px-2 py-2.5 hidden lg:table-cell text-xs text-surface-fg-muted">@(s.Description ?? "—")</td>
                            <td class="pl-2 pr-5 py-2.5 text-right whitespace-nowrap">
                                @if (s.IsBuiltin)
                                {
                                    <button type="button" class="btn btn-ghost text-xs"
                                            hx-get="/Network/Services/edit/@s.Id"
                                            hx-target="#drawer-body" hx-swap="innerHTML"
                                            @@click="$store.drawer.openRaw('Edit @s.Name')">Edit</button>
                                }
                                else
                                {
                                    @await Html.PartialAsync("_RowActions", new RowActionsViewModel
                                    {
                                        EditUrl = $"/Network/Services/edit/{s.Id}",
                                        EditDrawerTitle = $"Edit {s.Name}",
                                        DeleteUrl = $"/Network/Services/delete/{s.Id}",
                                        DeleteDialogTitle = "Delete service?",
                                        DeleteMessage = $"Delete service '{s.Name}'? Any firewall rules referencing it by name will silently skip the reference at next apply."
                                    })
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            }
        </table>
    </div>
}
