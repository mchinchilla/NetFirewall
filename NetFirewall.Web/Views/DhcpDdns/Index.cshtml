@{
    ViewData["Title"] = "DHCP — Dynamic DNS";
    Layout = "_Layout";
}

<div>
    <div class="flex flex-wrap items-end justify-between gap-3 mb-4"
         style="animation: var(--animate-slide-up);">
        <div>
            <p class="page-kicker">DHCP</p>
            <h1 class="text-2xl font-semibold tracking-tight">Dynamic DNS</h1>
            <p class="text-sm mt-1 max-w-2xl text-surface-fg-muted">
                Push lease records to a DNS authoritative server using TSIG-signed RFC 2136 updates.
                One row per scope: a global config plus optional per-subnet overrides.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-primary"
                    hx-get="/Dhcp/Ddns/edit"
                    hx-target="#drawer-body" hx-swap="innerHTML"
                    @@click="$store.drawer.openRaw('Add DDNS config')">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                Add DDNS config
            </button>
        </div>
    </div>

    <section style="animation: var(--animate-slide-up); animation-delay: 60ms;">
        @await Html.PartialAsync("_Grid", new GridFrameViewModel
        {
            GridId = NetFirewall.Web.Grids.Dhcp.DhcpDdnsGrid.Id,
            Title = "DHCP dynamic DNS configs",
            DefaultQuery = NetFirewall.Web.Grids.Dhcp.DhcpDdnsGrid.DefaultQuery,
            RefreshOn = ["refreshDdns"]
        })
    </section>
</div>
