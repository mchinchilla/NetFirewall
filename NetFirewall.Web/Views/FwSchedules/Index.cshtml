@{
    ViewData["Title"] = "Firewall — Schedules";
    Layout = "_Layout";
}
<div>
    <div class="flex flex-wrap items-end justify-between gap-3 mb-4"
         style="animation: var(--animate-slide-up);">
        <div>
            <p class="page-kicker">Firewall</p>
            <h1 class="text-2xl font-semibold tracking-tight">Schedules</h1>
            <p class="text-sm mt-1 max-w-2xl text-surface-fg-muted">
                Time windows that gate filter rules. Use <span class="font-medium text-surface-fg">Apply to devices</span> to limit a kid's phone or PC to a window (e.g. 06:00–22:00) using network objects. The daemon re-applies when a schedule transitions.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-primary"
                    hx-get="/Firewall/Schedules/edit"
                    hx-target="#drawer-body" hx-swap="innerHTML"
                    @@click="$store.drawer.openRaw('Add schedule')">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                Add schedule
            </button>
        </div>
    </div>

    <section style="animation: var(--animate-slide-up); animation-delay: 60ms;">
        @await Html.PartialAsync("_Grid", new GridFrameViewModel
        {
            GridId = NetFirewall.Web.Grids.Firewall.FwSchedulesGrid.Id,
            Title = "Firewall schedules",
            DefaultQuery = NetFirewall.Web.Grids.Firewall.FwSchedulesGrid.DefaultQuery,
            RefreshOn = ["refreshSchedules"]
        })
    </section>
</div>
