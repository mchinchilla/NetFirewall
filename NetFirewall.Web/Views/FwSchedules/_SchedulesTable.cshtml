@model IReadOnlyList<NetFirewall.Models.Firewall.FwSchedule>
@using NetFirewall.Web.Models.Shared
@{
    static string FormatDays(int[] dows)
    {
        if (dows.Length == 7) return "Daily";
        if (dows.SequenceEqual(new[] { 1, 2, 3, 4, 5 })) return "Weekdays";
        if (dows.SequenceEqual(new[] { 0, 6 })) return "Weekends";
        var names = new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
        return string.Join(" ", dows.OrderBy(d => d).Select(d => names[d]));
    }
    var nowUtc = DateTimeOffset.UtcNow;
    var enabled = Model.Count(s => s.Enabled);
    var disabled = Model.Count - enabled;
}

@if (Model.Count == 0)
{
    <div class="text-sm py-10 text-center text-surface-fg-muted">
        No schedules yet. Click <span class="font-medium text-surface-fg">Add schedule</span> to create one.
    </div>
}
else
{
    <div class="px-5 pb-2 text-xs text-surface-fg-muted">
        <span class="font-medium text-surface-fg">@enabled</span> active
        @if (disabled > 0) { <span>· @disabled off</span> }
        <span>· @Model.Count total</span>
    </div>
    <div class="overflow-x-auto -mx-5">
        <table class="min-w-full text-sm">
            <thead>
                <tr class="text-left text-[11px] uppercase tracking-wider text-surface-fg-muted border-b border-surface-border">
                    <th class="pl-5 pr-2 py-1.5 font-medium">Name</th>
                    <th class="px-2 py-1.5 font-medium">Window</th>
                    <th class="px-2 py-1.5 font-medium hidden md:table-cell">Days</th>
                    <th class="px-2 py-1.5 font-medium w-24">Status</th>
                    <th class="pl-2 pr-5 py-1.5 font-medium text-right w-44">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y border-surface-border">
                @foreach (var s in Model)
                {
                    var active = s.IsActiveAt(nowUtc);
                    var window = $"{s.StartTime.ToString(@"hh\:mm")}–{s.EndTime.ToString(@"hh\:mm")}";
                    var days = FormatDays(s.DaysOfWeek);
                    <tr data-disabled="@(s.Enabled ? "false" : "true")">
                        <td class="pl-5 pr-2 py-2.5">
                            <div class="font-medium text-surface-fg">@s.Name</div>
                            @if (!string.IsNullOrEmpty(s.Description))
                            {
                                <p class="text-xs font-normal text-surface-fg-muted">@s.Description</p>
                            }
                        </td>
                        <td class="px-2 py-2.5">
                            <div class="flex items-center gap-1 flex-wrap">
                                @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "window", Value = window })
                                @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "tz", Value = s.Timezone })
                            </div>
                        </td>
                        <td class="px-2 py-2.5 hidden md:table-cell">
                            @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "days", Value = days })
                        </td>
                        <td class="px-2 py-2.5 whitespace-nowrap">
                            @if (!s.Enabled)
                            {
                                <span class="badge badge-muted">Off</span>
                            }
                            else if (active)
                            {
                                <span class="inline-flex items-center gap-1.5 badge badge-success">
                                    <span class="inline-block h-1.5 w-1.5 rounded-full bg-feedback-success-fg"></span>
                                    Active now
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-muted">Idle</span>
                            }
                        </td>
                        <td class="pl-2 pr-5 py-2.5 text-right whitespace-nowrap">
                            <div class="inline-flex items-center gap-1">
                                <button type="button" class="btn btn-ghost text-xs"
                                        hx-get="/Firewall/FilterRules/time-policy?scheduleId=@s.Id"
                                        hx-target="#drawer-body" hx-swap="innerHTML"
                                        @@click="$store.drawer.openRaw('Apply @s.Name')">Apply to devices</button>
                                @await Html.PartialAsync("_RowActions", new RowActionsViewModel
                                {
                                    EditUrl = $"/Firewall/Schedules/edit/{s.Id}",
                                    EditDrawerTitle = $"Edit {s.Name}",
                                    DeleteUrl = $"/Firewall/Schedules/delete/{s.Id}",
                                    DeleteDialogTitle = "Delete schedule?",
                                    DeleteMessage = $"Delete schedule '{s.Name}'? Time-limit policies attached to it will be removed. Other filter rules that used this window will be disabled — not left always-on."
                                })
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
