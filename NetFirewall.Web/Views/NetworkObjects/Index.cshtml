@{
    ViewData["Title"] = "Network — Objects";
    Layout = "_Layout";
}

<div class="flex flex-wrap items-end justify-between gap-3 mb-4"
     style="animation: var(--animate-slide-up);">
    <div>
        <p class="page-kicker">Network</p>
        <h1 class="text-2xl font-semibold tracking-tight">Objects</h1>
        <p class="text-sm mt-1 max-w-2xl text-surface-fg-muted">
            Named, reusable address aliases. Reference them in firewall rule source/destination instead of literal CIDRs — change the value once, every rule picks it up at next apply.
        </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        <button type="button" class="btn btn-primary"
                hx-get="/Network/Objects/edit"
                hx-target="#drawer-body" hx-swap="innerHTML"
                @@click="$store.drawer.openRaw('Add object')">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
            Add object
        </button>
    </div>
</div>

<section style="animation: var(--animate-slide-up); animation-delay: 60ms;">
    @await Html.PartialAsync("_Grid", new GridFrameViewModel
    {
        GridId = NetFirewall.Web.Grids.Network.NetworkObjectsGrid.Id,
        Title = "Network objects",
        DefaultQuery = NetFirewall.Web.Grids.Network.NetworkObjectsGrid.DefaultQuery,
        RefreshOn = ["refreshNetworkObjects"]
    })
</section>
