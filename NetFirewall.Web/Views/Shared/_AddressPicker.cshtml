@model NetFirewall.Web.Models.AddressPickerViewModel
@*
    Tag-input whose suggestion list is loaded with HTMX (GET /Network/Objects/autocomplete)
    and whose chips/hidden CSV live in Alpine. The search input is detached from the
    parent <form> via form="…" so `q` never posts with the rule/policy.
*@
@{
    var fieldId = $"addr-{Model.Name.Replace(".", "-")}";
    var suggestId = $"suggest-{fieldId}";
    var hxForm = $"hx-{fieldId}";
    var hxTrigger = Model.OpenOnEmpty
        ? "focus, keyup changed delay:150ms, suggest"
        : "keyup changed delay:150ms, suggest";
}

<div class="space-y-1.5"
     data-initial="@(Model.Value ?? string.Empty)"
     data-open-empty="@(Model.OpenOnEmpty ? "true" : "false")"
     x-data="addressPicker()"
     x-init="$nextTick(() => $refs.hidden.value = csv)">
    <label for="@fieldId" class="block text-xs font-medium text-surface-fg">
        @Model.Label
        @if (Model.Required)
        {
            <span class="text-feedback-danger-fg">*</span>
        }
    </label>

    <input type="hidden" name="@Model.Name" :value="csv" x-ref="hidden" />
    @* Detached from the parent form — HTMX include only. *@
    <input type="hidden" name="except" form="@hxForm" :value="csv" />

    <div class="relative">
        <div class="input flex flex-wrap items-center gap-1.5 min-h-9 cursor-text"
             style="padding: 0.375rem 0.5rem;"
             @@click="$refs.text.focus()">
            <template x-for="(tag, i) in tags" :key="`${tag}-${i}`">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium"
                      :style="looksLikeLiteral(tag)
                          ? 'background: color-mix(in srgb, var(--surface-fg-muted) 14%, transparent); color: var(--surface-fg);'
                          : 'background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent);'">
                    <svg x-show="!looksLikeLiteral(tag)" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068"/></svg>
                    <span class="font-mono" x-text="tag"></span>
                    <button type="button" class="-mr-0.5 opacity-60 hover:opacity-100"
                            @@click.stop="removeTag(i)" tabindex="-1"
                            aria-label="Remove">
                        <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
                    </button>
                </span>
            </template>
            <input type="text" id="@fieldId" name="q" form="@hxForm" x-ref="text"
                   x-model="input"
                   autocomplete="off"
                   hx-get="/Network/Objects/autocomplete"
                   hx-target="#@suggestId"
                   hx-swap="innerHTML"
                   hx-include="[form='@hxForm']"
                   hx-sync="this:replace"
                   hx-trigger="@hxTrigger"
                   @@keydown="onKey($event)"
                   @@blur="onBlur()"
                   class="flex-1 min-w-32 outline-none bg-transparent text-sm"
                   placeholder="@(Model.Placeholder ?? "Type CIDR or object name…")" />
            @if (Model.OpenOnEmpty)
            {
                <button type="button" tabindex="-1"
                        class="shrink-0 px-1 text-surface-fg-muted"
                        :aria-label="open ? 'Close object list' : 'Open object list'"
                        @@mousedown.prevent="open ? closeList() : suggest()">
                    <svg class="h-4 w-4 transition" :class="open ? 'rotate-180' : ''"
                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                    </svg>
                </button>
            }
        </div>

        <div id="@suggestId" x-ref="list" x-show="open" x-cloak
             x-transition.opacity.duration.100ms
             class="absolute z-30 left-0 right-0 mt-1 max-h-60 overflow-y-auto rounded-md shadow-lg border bg-surface-elevated border-surface-border"
             @@mousedown.prevent="pick($event)"
             @@htmx:after-swap="onSuggestSwap()">
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Help))
    {
        <p class="text-xs text-surface-fg-muted">@Model.Help</p>
    }
</div>

