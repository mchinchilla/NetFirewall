@model NetFirewall.Web.Models.Shared.VersionBadgeViewModel
@*
    Build identity: version pill (→ GitHub Release, else the commit), commit chip
    (→ the commit), "modified" when built from a dirty tree, and the environment
    when it isn't Production. Used by the layout footer and the login System info card.
*@
@{
    const string chip = "inline-flex items-center gap-1 rounded-full border px-2 py-0.5 font-mono text-[11px] leading-4";
    const string external = "noopener noreferrer";
}
<span class="inline-flex flex-wrap items-center gap-1.5" title="@Model.Title">
    @if (Model.VersionUrl is { } versionUrl)
    {
        <a href="@versionUrl" target="_blank" rel="@external"
           class="@chip border-transparent bg-accent-soft text-accent font-semibold transition-opacity hover:opacity-80">
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z"/></svg>
            v@(Model.DisplayVersion)
        </a>
    }
    else
    {
        <span class="@chip border-transparent bg-accent-soft text-accent font-semibold">v@(Model.DisplayVersion)</span>
    }

    @if (Model.ShowCommit && Model.CommitUrl is { } commitUrl)
    {
        <a href="@commitUrl" target="_blank" rel="@external"
           class="@chip border-surface-border text-surface-fg-muted transition-colors hover:text-surface-fg hover:border-accent">
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3.25"/><path stroke-linecap="round" d="M3 12h5.75M15.25 12H21"/></svg>
            @Model.Build.Commit
        </a>
    }

    @if (Model.Build.IsDirty)
    {
        <span class="@chip border-feedback-warning-bd bg-feedback-warning-bg text-feedback-warning-fg"
              title="Built from a working tree with uncommitted changes">modified</span>
    }

    @if (Model.ShowEnvironment)
    {
        <span class="@chip border-feedback-info-bd bg-feedback-info-bg text-feedback-info-fg">@Model.Environment</span>
    }
</span>
