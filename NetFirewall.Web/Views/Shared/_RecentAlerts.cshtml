@model NetFirewall.Web.Models.NotificationsViewModel
@{
    static string Ago(DateTime utc)
    {
        var d = DateTime.UtcNow - utc;
        if (d.TotalMinutes < 1) return "just now";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalHours < 24) return $"{(int)d.TotalHours}h ago";
        return $"{(int)d.TotalDays}d ago";
    }
}
<section class="card">
    <header class="flex items-baseline justify-between mb-3">
        <div>
            <h2 class="text-base font-semibold">System alerts</h2>
            <p class="text-xs text-surface-fg-muted">
                @if (Model.ActiveCount > 0)
                {
                    <span>@Model.ActiveCount active</span>
                }
                else
                {
                    <span>WAN / VPN / failover</span>
                }
            </p>
        </div>
        <a href="/Alerts" class="text-xs hover:underline text-accent">Activity →</a>
    </header>
    @if (Model.Items.Count == 0)
    {
        <p class="text-sm py-6 text-center text-surface-fg-muted">No recent alerts.</p>
    }
    else
    {
        <ul class="divide-y border-surface-border">
            @foreach (var n in Model.Items.Take(8))
            {
                var badge = n.Severity switch
                {
                    "danger" => "badge-danger",
                    "warning" => "badge-warning",
                    _ => "badge-info"
                };
                <li class="py-2 @(n.IsActive ? "" : "opacity-60")">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="text-sm font-medium truncate">@n.Title</p>
                            <p class="text-[11px] text-surface-fg-muted mt-0.5">
                                <span class="uppercase tracking-wide">@n.Source</span>
                                · @Ago(n.RaisedAt)
                                @if (!n.IsActive) { <span>· resolved</span> }
                            </p>
                        </div>
                        <span class="badge @badge shrink-0">@n.Severity</span>
                    </div>
                </li>
            }
        </ul>
    }
</section>
