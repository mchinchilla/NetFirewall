@model NetFirewall.Web.Models.Shared.WakeButtonViewModel
@*
    Wake-on-LAN trigger, shared by the Wake-on-LAN device list and the DHCP
    reservation / lease rows. The daemon sends the packet; the answer is a toast
    (plus refreshWol, which re-reads the device list and its ARP presence).
*@
<button type="button" class="btn btn-ghost text-xs"
        hx-post="@Model.Url"
        hx-vals="@System.Text.Json.JsonSerializer.Serialize(Model.Values)"
        hx-swap="none"
        hx-disabled-elt="this"
        title="Send a Wake-on-LAN magic packet to @Model.Subject">
    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5.636 5.636a9 9 0 1 0 12.728 0M12 3v9"/></svg>
    @Model.Label
</button>
