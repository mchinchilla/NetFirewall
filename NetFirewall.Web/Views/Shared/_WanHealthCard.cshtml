@model NetFirewall.Web.Models.Network.WanHealthCardViewModel
@using NetFirewall.Web.Models.Firewall
@using NetFirewall.Web.Models.Network
@using NetFirewall.Web.Models.Shared

@{
    var o = Model.Options;

    // "X ago" for a UTC timestamp — local helper so the card is self-contained.
    static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        if (span.TotalSeconds < 60) return $"{(int)span.TotalSeconds}s ago";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours   < 24) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }
}

@if (Model.NotConfigured)
{
    @if (o.ShowControls)
    {
        @* Full empty-state for the failover page — explains how to arm failover. *@
        <div class="card">
            <div class="flex items-start gap-3">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full"
                      style="background-color: var(--feedback-warning-bg); color: var(--feedback-warning-fg);">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/></svg>
                </span>
                <div>
                    <h2 class="text-base font-semibold">Failover not configured</h2>
                    <p class="text-sm mt-1 text-surface-fg-muted">
                        No WAN health-probe config rows exist, so the daemon isn't monitoring any WAN and
                        <span class="font-medium text-surface-fg">automatic failover is inactive</span>.
                        Assign <span class="font-mono">primary_wan</span> / <span class="font-mono">secondary_wan</span>
                        roles to your WAN interfaces and re-run migrations to auto-seed this, or add a config row per WAN.
                    </p>
                </div>
            </div>
        </div>
    }
    else
    {
        <p class="text-sm py-6 text-center text-surface-fg-muted">
            No WAN health-probe config rows exist — automatic failover is inactive.
            @if (!string.IsNullOrEmpty(o.ManageUrl))
            {
                <a href="@o.ManageUrl" class="hover:underline text-accent">Configure WAN failover →</a>
            }
        </p>
    }
}
else
{
    @* ── Mode banner (auto vs pinned). ── *@
    @if (o.ShowModeBanner)
    {
        <div class="@(o.ShowControls ? "card mb-4 flex flex-wrap items-center justify-between gap-3" : "mb-3")">
            @if (Model.IsOverridden)
            {
                <div class="flex items-center gap-2">
                    <span class="badge badge-warning">Pinned</span>
                    <p class="text-sm">
                        <span class="font-semibold">@Model.OverrideInterfaceName</span> is pinned as the active WAN
                        @if (o.ShowControls && !string.IsNullOrEmpty(Model.OverrideSetBy)) { <span class="text-surface-fg-muted">by @Model.OverrideSetBy</span> }
                        <span class="text-surface-fg-muted">— automatic priority failover is paused until it goes down.</span>
                    </p>
                </div>
            }
            else if (o.ShowControls)
            {
                <div class="flex items-center gap-3">
                    <span class="badge badge-accent">Automatic</span>
                    <p class="text-sm text-surface-fg-muted">The lowest-priority healthy WAN is selected automatically.</p>
                </div>
            }

            @if (o.ShowControls && Model.IsOverridden)
            {
                <button type="button" class="btn btn-ghost text-sm"
                        hx-post="/Network/Wan/clear-override"
                        hx-swap="none"
                        hx-trigger="confirmed-clear"
                        @@click.prevent="(async () => {
                            const ok = await $store.confirm.ask({
                                title: 'Return to automatic?',
                                message: 'Clear the manual pin and let priority-based failover choose the active WAN again.',
                                confirmLabel: 'Return to auto',
                                level: 'default'
                            });
                            if (ok) htmx.trigger($el, 'confirmed-clear');
                        })()">
                    Return to automatic
                </button>
            }
        </div>
    }

    @if (Model.IsFallback)
    {
        <p class="text-xs mb-2 text-surface-fg-muted">Instant ping snapshot (no hysteresis) — health-probe state not populated yet.</p>
    }

    @* ── Rows: Cards grid (failover) or compact list (pod / dashboard). ── *@
    @if (o.Layout == WanCardLayout.Cards)
    {
        <div class="grid gap-4 md:grid-cols-2">
            @foreach (var w in Model.Wans)
            {
                <div class="card">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                @await Html.PartialAsync("_IfaceChip", new IfaceChipViewModel { Name = w.Name, Type = "wan" })
                                @if (w.IsActive)
                                {
                                    <span class="badge badge-accent">Active</span>
                                }
                                @if (w.IsPinned)
                                {
                                    <span class="badge badge-warning">Pinned</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(w.Role))
                            {
                                <p class="text-xs mt-1 text-surface-fg-muted">@w.Role.Replace("_", " ")</p>
                            }
                        </div>
                        @if (w.IsUp)
                        {
                            <span class="badge badge-success">Up</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">Down</span>
                        }
                    </div>

                    <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
                        <dt class="text-surface-fg-muted">Last probe</dt>
                        <dd class="text-right">
                            @if (w.LastRttMs is { } rtt)
                            {
                                @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "rtt", Value = $"{rtt:0.#} ms" })
                            }
                            else
                            {
                                <span class="text-surface-fg-muted">—</span>
                            }
                        </dd>
                        <dt class="text-surface-fg-muted">Target</dt>
                        <dd class="text-right">
                            @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "dst", Value = w.LastTarget ?? "gateway" })
                        </dd>
                        @if (o.ShowHysteresis && !w.IsUp && w.ConsecutiveFailures > 0)
                        {
                            <dt class="text-surface-fg-muted">Failures</dt>
                            <dd class="text-right" style="color: var(--feedback-danger-fg);">@w.ConsecutiveFailures consecutive</dd>
                        }
                        else if (o.ShowHysteresis && w.IsUp && w.ConsecutiveSuccesses > 0)
                        {
                            <dt class="text-surface-fg-muted">Successes</dt>
                            <dd class="text-right">@w.ConsecutiveSuccesses consecutive</dd>
                        }
                        @if (!string.IsNullOrEmpty(w.LastError))
                        {
                            <dt class="text-surface-fg-muted">Last error</dt>
                            <dd class="text-right text-xs truncate" style="color: var(--feedback-danger-fg);" title="@w.LastError">@w.LastError</dd>
                        }
                    </dl>

                    @if (o.ShowControls)
                    {
                        <div class="mt-4 pt-3 border-t flex items-center justify-end gap-2 border-surface-border">
                            <button type="button" class="btn btn-ghost text-sm"
                                    hx-get="/Network/Wan/config/@w.InterfaceId"
                                    hx-target="#drawer-body" hx-swap="innerHTML"
                                    @@click="$store.drawer.openRaw('Probe config — @w.Name')">
                                Configure
                            </button>
                            @if (!w.IsActive)
                            {
                                <button type="button" class="btn btn-primary text-sm"
                                        hx-post="/Network/Wan/swap/@w.InterfaceId"
                                        hx-swap="none"
                                        hx-trigger="confirmed-swap"
                                        data-name="@w.Name"
                                        data-up="@(w.IsUp ? "1" : "0")"
                                        @@click.prevent="(async () => {
                                            const el = $event.currentTarget;
                                            const name = el.dataset.name;
                                            const isUp = el.dataset.up === '1';
                                            const ok = await $store.confirm.ask({
                                                title: 'Switch active WAN?',
                                                message: isUp
                                                    ? ('Make ' + name + ' the active default route and pin it. Active connections may briefly drop while routing changes.')
                                                    : ('⚠ ' + name + ' is currently DOWN. Forcing it active will likely black-hole traffic until it recovers. Continue anyway?'),
                                                confirmLabel: 'Switch to ' + name,
                                                level: isUp ? 'warning' : 'danger'
                                            });
                                            if (ok) htmx.trigger(el, 'confirmed-swap');
                                        })()">
                                    Make active
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <ul class="divide-y border-surface-border">
            @foreach (var w in Model.Wans)
            {
                <li class="flex items-center justify-between gap-3 py-3">
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            @await Html.PartialAsync("_IfaceChip", new IfaceChipViewModel { Name = w.Name, Type = "wan" })
                            @if (w.IsActive)
                            {
                                <span class="badge badge-accent">Active</span>
                            }
                            @if (w.IsPinned)
                            {
                                <span class="badge badge-warning">Pinned</span>
                            }
                            @if (w.IsUp)
                            {
                                <span class="badge badge-success">Up</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Down</span>
                            }
                        </div>
                        <p class="text-xs mt-1 text-surface-fg-muted">
                            <span class="@(w.IsUp ? "text-feedback-success-fg" : "text-feedback-danger-fg")">@(w.IsUp ? "Up" : "Down")</span>
                            @if (!string.IsNullOrEmpty(w.Role))
                            {
                                <span> · @w.Role.Replace("_", " ")</span>
                            }
                            @if (o.ShowHysteresis && !w.IsUp && w.ConsecutiveFailures > 0)
                            {
                                <span> · @w.ConsecutiveFailures fail(s)</span>
                            }
                            @if (!w.IsUp && !string.IsNullOrEmpty(w.LastError))
                            {
                                <span class="truncate" title="@w.LastError"> · @w.LastError</span>
                            }
                        </p>
                    </div>
                    <div class="text-right shrink-0">
                        <div class="font-mono text-sm">@(w.LastRttMs is { } rtt ? $"{rtt:0.#} ms" : "—")</div>
                        @if (w.LastCheckAt is { } at && at != default)
                        {
                            <time class="text-[11px] text-surface-fg-muted" datetime="@at.ToString("o")">@Ago(at)</time>
                        }
                    </div>
                </li>
            }
        </ul>
    }

    @* ── Recent transitions timeline (opt-in). Nested .card only in the
         full failover panel; list/pod surfaces keep a simple heading. ── *@
    @if (o.ShowEvents)
    {
        var eventsWrap = o.Layout == WanCardLayout.Cards ? "card mt-4" : "mt-4 pt-3 border-t border-surface-border";
        <div class="@eventsWrap">
            <h2 class="text-sm font-semibold mb-2">Recent failover activity</h2>
            @if (Model.RecentEvents.Count == 0)
            {
                <p class="text-sm text-surface-fg-muted">No failover events recorded yet.</p>
            }
            else
            {
                <ul class="divide-y border-surface-border">
                    @foreach (var e in Model.RecentEvents.Take(8))
                    {
                        var (label, badgeCls) = e.EventType switch
                        {
                            "up"       => ("recovered", "badge-success"),
                            "down"     => ("went down", "badge-danger"),
                            "failover" => ("became active", "badge-accent"),
                            "demoted"  => ("demoted", "badge-muted"),
                            _          => (e.EventType, "badge-muted"),
                        };
                        <li class="flex items-center justify-between gap-3 py-2 text-sm">
                            <span class="flex items-center gap-2 flex-wrap">
                                <span class="font-mono font-medium">@e.InterfaceName</span>
                                <span class="badge @badgeCls">@label</span>
                            </span>
                            <time class="text-xs text-surface-fg-muted shrink-0" datetime="@e.OccurredAt.ToString("o")">
                                @e.OccurredAt.ToLocalTime().ToString("MMM d, HH:mm:ss")
                            </time>
                        </li>
                    }
                </ul>
            }
        </div>
    }
}
