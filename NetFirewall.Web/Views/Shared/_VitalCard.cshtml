@model NetFirewall.Web.Models.VitalCardViewModel
@{
    var tintClass = Model.Tint switch
    {
        NetFirewall.Web.Models.KpiTint.Coral  => "kpi-tint-coral",
        NetFirewall.Web.Models.KpiTint.Mint   => "kpi-tint-mint",
        NetFirewall.Web.Models.KpiTint.Blue   => "kpi-tint-blue",
        NetFirewall.Web.Models.KpiTint.Violet => "kpi-tint-violet",
        NetFirewall.Web.Models.KpiTint.Gold   => "kpi-tint-gold",
        _                                     => "kpi-tint-accent"
    };
}
<section class="kpi"
         x-data="liveStat('@Model.Field')">
    <div class="hidden" aria-hidden="true"
         hx-get="/Home/SystemSeries"
         hx-trigger="load, every 10s"
         hx-swap="none"
         @@htmx:after-request="onHtmx($event)"></div>
    <div class="flex items-start gap-3">
        <span class="kpi-icon @tintClass">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="@Model.IconPath" />
            </svg>
        </span>
        <div class="min-w-0 flex-1">
            <p class="kpi-label">@Model.Label</p>
            <p class="kpi-value mt-0.5">
                <span x-text="current">—</span><span class="text-base font-normal text-surface-fg-muted">@Model.Unit</span>
            </p>
        </div>
    </div>
    <div class="relative h-14 mt-3"><canvas x-ref="spark" class="block w-full h-full"></canvas></div>
    <p class="text-[10px] text-surface-fg-muted mt-1">@Model.Caption</p>
</section>
