@*
    One WAN's live up/down chart. Not invoked with a server model — Alpine
    x-for clones this markup per interface. Keep the structure here so the
    grid host (_WanTrafficCharts) stays a one-line compose.
*@
<article class="card flex-1 min-w-0">
    <header class="flex items-start justify-between gap-3 mb-2">
        <div class="min-w-0">
            <h3 class="text-sm font-semibold truncate" x-text="wan.name">—</h3>
            <p class="text-[10px] uppercase tracking-wider text-surface-fg-muted" x-text="wan.label">WAN</p>
        </div>
        <div class="flex items-baseline gap-3 shrink-0">
            <div class="text-right">
                <p class="text-[10px] uppercase tracking-wider text-surface-fg-muted">↓ in</p>
                <p class="text-sm font-semibold tabular-nums" x-text="fmtMbps(wan.inMbps)">—</p>
            </div>
            <div class="text-right">
                <p class="text-[10px] uppercase tracking-wider text-surface-fg-muted">↑ out</p>
                <p class="text-sm font-semibold tabular-nums" x-text="fmtMbps(wan.outMbps)">—</p>
            </div>
        </div>
    </header>
    <div class="relative" :class="compact ? 'h-20' : 'h-40'">
        <canvas :data-iface="wan.name"></canvas>
    </div>
</article>
