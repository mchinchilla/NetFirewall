@model int
@*
    "Wake all (N)" / "Wake selected (k)" — one button for both. Lives inside the
    wolSelection scope of _DevicesTable (site.js); the model is the device count,
    so the label is right before Alpine starts. Ticked ids ride along via
    hx-include; the scope is explicit so a lost selection is refused, not widened.
*@
<button type="button" class="btn btn-primary text-xs"
        hx-post="/Network/WakeOnLan/wake-many"
        hx-trigger="confirmed-wake"
        hx-include="[data-wol-select]"
        :hx-vals="JSON.stringify({ scope })"
        hx-swap="none"
        hx-disabled-elt="this"
        @@click.prevent="confirmWake($el)">
    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5.636 5.636a9 9 0 1 0 12.728 0M12 3v9"/></svg>
    <span x-text="label">Wake all (@Model)</span>
</button>
