@model IReadOnlyList<NetFirewall.Models.Firewall.FwPortForward>
@using NetFirewall.Web.Models.Firewall
@using NetFirewall.Web.Models.Shared
@{
    var ifaceNames = (IDictionary<Guid, string>)(ViewBag.InterfaceNames ?? new Dictionary<Guid, string>());
    var ifaceTypes = (IDictionary<Guid, string>)(ViewBag.InterfaceTypes ?? new Dictionary<Guid, string>());
    string Ext(NetFirewall.Models.Firewall.FwPortForward pf) =>
        pf.ExternalPortEnd.HasValue && pf.ExternalPortEnd.Value > pf.ExternalPortStart
            ? $"{pf.ExternalPortStart}-{pf.ExternalPortEnd.Value}"
            : pf.ExternalPortStart.ToString();
    var enabled = Model.Count(p => p.Enabled);
    var disabled = Model.Count - enabled;
    var grouped = Model
        .OrderBy(p => p.Priority)
        .GroupBy(p =>
        {
            var name = p.InterfaceId is { } id && ifaceNames.TryGetValue(id, out var n) ? n : "any";
            return name;
        });
}

@if (Model.Count == 0)
{
    <div class="text-sm py-10 text-center text-surface-fg-muted">
        No port forwards configured. Click <span class="font-medium text-surface-fg">Add forward</span> to create one.
    </div>
}
else
{
    <div class="px-5 pb-2 text-xs text-surface-fg-muted">
        <span class="font-medium text-surface-fg">@enabled</span> active
        @if (disabled > 0) { <span>· @disabled off</span> }
        <span>· @Model.Count total</span>
    </div>
    <div class="overflow-x-auto -mx-5">
        <table class="min-w-full text-sm">
            @foreach (var group in grouped)
            {
                var gEnabled = group.Count(x => x.Enabled);
                var gOff = group.Count() - gEnabled;
                var sample = group.First();
                var gType = sample.InterfaceId is { } tid && ifaceTypes.TryGetValue(tid, out var t) ? t : null;
                <thead>
                    <tr>
                        <th colspan="6" class="px-5 pt-5 pb-2 text-left">
                            <div class="flex items-baseline gap-2 flex-wrap">
                                @await Html.PartialAsync("_IfaceChip", new IfaceChipViewModel { Name = group.Key, Type = gType })
                                <span class="text-xs font-normal text-surface-fg-muted">
                                    · @gEnabled active@(gOff > 0 ? $", {gOff} off" : "")
                                </span>
                            </div>
                        </th>
                    </tr>
                    <tr class="text-left text-[11px] uppercase tracking-wider text-surface-fg-muted border-b border-surface-border">
                        <th class="pl-5 pr-2 py-1.5 font-medium w-12">Pri</th>
                        <th class="px-2 py-1.5 font-medium">Forward</th>
                        <th class="px-2 py-1.5 font-medium">External → Internal</th>
                        <th class="px-2 py-1.5 font-medium hidden md:table-cell">Sources</th>
                        <th class="px-2 py-1.5 font-medium w-20">Status</th>
                        <th class="pl-2 pr-5 py-1.5 font-medium text-right w-28">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y border-surface-border">
                    @foreach (var pf in group)
                    {
                        var ext = Ext(pf);
                        var sources = pf.SourceAddresses is { Length: > 0 }
                            ? string.Join(", ", pf.SourceAddresses)
                            : "any";
                        <tr data-disabled="@(pf.Enabled ? "false" : "true")">
                            <td class="pl-5 pr-2 py-2.5 font-mono text-xs tabular-nums text-surface-fg-muted">@pf.Priority</td>
                            <td class="px-2 py-2.5">
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    @if (!string.IsNullOrWhiteSpace(pf.Description))
                                    {
                                        <span class="text-surface-fg">@pf.Description</span>
                                    }
                                    else
                                    {
                                        <span class="text-surface-fg">@pf.Protocol.ToUpperInvariant() / @ext</span>
                                    }
                                </div>
                                <div class="flex items-center gap-1 flex-wrap mt-1">
                                    @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "proto", Value = pf.Protocol })
                                    @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "ext", Value = ext })
                                </div>
                            </td>
                            <td class="px-2 py-2.5 font-mono text-xs">
                                :@ext <span class="text-surface-fg-muted">→</span> @pf.InternalIp:@pf.InternalPort
                            </td>
                            <td class="px-2 py-2.5 hidden md:table-cell">
                                @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "src", Value = sources, Title = sources })
                            </td>
                            <td class="px-2 py-2.5 whitespace-nowrap">
                                @if (pf.Enabled)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-muted">Off</span>
                                }
                            </td>
                            <td class="pl-2 pr-5 py-2.5 text-right whitespace-nowrap">
                                @await Html.PartialAsync("_RowActions", new RowActionsViewModel
                                {
                                    EditUrl = $"/Firewall/PortForwards/edit/{pf.Id}",
                                    EditDrawerTitle = "Edit port forward",
                                    DeleteUrl = $"/Firewall/PortForwards/delete/{pf.Id}",
                                    DeleteDialogTitle = "Delete forward?",
                                    DeleteMessage = $"Delete forward {pf.Protocol}/{ext} → {pf.InternalIp}:{pf.InternalPort}?"
                                })
                            </td>
                        </tr>
                    }
                </tbody>
            }
        </table>
    </div>
}
