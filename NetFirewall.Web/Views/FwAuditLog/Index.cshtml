@{
    ViewData["Title"] = "Firewall — Audit log";
    Layout = "_Layout";
}
<div>
    <div class="flex flex-wrap items-end justify-between gap-3 mb-4"
         style="animation: var(--animate-slide-up);">
        <div>
            <p class="page-kicker">Firewall</p>
            <h1 class="text-2xl font-semibold tracking-tight">Audit log</h1>
            <p class="text-sm mt-1 max-w-2xl text-surface-fg-muted">Every CRUD on firewall tables — who, when, before/after. Opens on the last 24 h; expand a row for the diff.</p>
        </div>
    </div>

    <section style="animation: var(--animate-slide-up); animation-delay: 60ms;">
        @await Html.PartialAsync("_Grid", new GridFrameViewModel
        {
            GridId = NetFirewall.Web.Grids.Firewall.FwAuditLogGrid.Id,
            Title = "Firewall audit log",
            DefaultQuery = NetFirewall.Web.Grids.Firewall.FwAuditLogGrid.DefaultQuery(DateTime.UtcNow),
            RefreshOn = []
        })
    </section>
</div>
