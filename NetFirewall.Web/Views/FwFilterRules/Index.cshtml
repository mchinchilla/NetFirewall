@{
    ViewData["Title"] = "Firewall — Filter rules";
    Layout = "_Layout";
}

<div id="filter-rules-page" x-data="filterRulesPage()">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-4"
         style="animation: var(--animate-slide-up);">
        <div>
            <p class="text-xs uppercase tracking-wider font-semibold text-surface-fg-muted">Firewall</p>
            <h1 class="text-2xl font-semibold tracking-tight">Filter rules</h1>
            <p class="text-sm mt-1 max-w-2xl text-surface-fg-muted">
                Stateful packet filter. Within a chain the first match wins, so lower priority is checked first.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-ghost"
                    hx-get="/Firewall/FilterRules/time-policy"
                    hx-target="#drawer-body" hx-swap="innerHTML"
                    @@click="$store.drawer.openRaw('Time policy')">
                Time policy
            </button>
            <button type="button" class="btn btn-primary"
                    hx-get="/Firewall/FilterRules/edit"
                    hx-target="#drawer-body" hx-swap="innerHTML"
                    @@click="$store.drawer.openRaw('Add filter rule')">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                Add rule
            </button>
        </div>
    </div>

    @* Filter controls ARE the HTMX requests. Each button bakes its own chain/view
       into hx-vals so the first click sends the value that was clicked — not a
       stale Alpine binding flushed on the next tick. *@
    <div class="flex flex-wrap items-center gap-2 mb-4"
         style="animation: var(--animate-slide-up); animation-delay: 40ms;"
         hx-target="#filter-rules-table"
         hx-swap="innerHTML"
         hx-sync="#filter-rules-table:replace">
        @await Html.PartialAsync("_TableSearch", new TableSearchModel { TableId = "filter-rules-table", Placeholder = "Filter by action, address, port, interface…", ClientSide = true })

        <div class="seg" role="group" aria-label="Chain">
            <button type="button" class="seg-btn" :class="chain === '' ? 'is-on' : ''"
                    :aria-pressed="(chain === '').toString()"
                    hx-get="/Firewall/FilterRules/table"
                    :hx-vals="JSON.stringify({ chain: '', view })"
                    @@click="chain = ''">All</button>
            <button type="button" class="seg-btn" :class="chain === 'input' ? 'is-on' : ''"
                    :aria-pressed="(chain === 'input').toString()"
                    hx-get="/Firewall/FilterRules/table"
                    :hx-vals="JSON.stringify({ chain: 'input', view })"
                    @@click="chain = 'input'">Input</button>
            <button type="button" class="seg-btn" :class="chain === 'forward' ? 'is-on' : ''"
                    :aria-pressed="(chain === 'forward').toString()"
                    hx-get="/Firewall/FilterRules/table"
                    :hx-vals="JSON.stringify({ chain: 'forward', view })"
                    @@click="chain = 'forward'">Forward</button>
            <button type="button" class="seg-btn" :class="chain === 'output' ? 'is-on' : ''"
                    :aria-pressed="(chain === 'output').toString()"
                    hx-get="/Firewall/FilterRules/table"
                    :hx-vals="JSON.stringify({ chain: 'output', view })"
                    @@click="chain = 'output'">Output</button>
        </div>

        <div class="seg" role="group" aria-label="Group by">
            <button type="button" class="seg-btn" :class="view === 'evaluation' ? 'is-on' : ''"
                    :aria-pressed="(view === 'evaluation').toString()"
                    hx-get="/Firewall/FilterRules/table"
                    :hx-vals="JSON.stringify({ chain, view: 'evaluation' })"
                    @@click="view = 'evaluation'">Chain</button>
            <button type="button" class="seg-btn" :class="view === 'interface' ? 'is-on' : ''"
                    :aria-pressed="(view === 'interface').toString()"
                    hx-get="/Firewall/FilterRules/table"
                    :hx-vals="JSON.stringify({ chain, view: 'interface' })"
                    @@click="view = 'interface'">Interface</button>
            <button type="button" class="seg-btn" :class="view === 'action' ? 'is-on' : ''"
                    :aria-pressed="(view === 'action').toString()"
                    hx-get="/Firewall/FilterRules/table"
                    :hx-vals="JSON.stringify({ chain, view: 'action' })"
                    @@click="view = 'action'">Verdict</button>
            <button type="button" class="seg-btn" :class="view === 'service' ? 'is-on' : ''"
                    :aria-pressed="(view === 'service').toString()"
                    hx-get="/Firewall/FilterRules/table"
                    :hx-vals="JSON.stringify({ chain, view: 'service' })"
                    @@click="view = 'service'">Service</button>
        </div>

        <label class="text-xs flex items-center gap-2 cursor-pointer select-none text-surface-fg-muted">
            <input type="checkbox" class="rounded" x-model="hideDisabled" />
            Hide disabled
        </label>
    </div>

    <section class="card" style="animation: var(--animate-slide-up); animation-delay: 80ms;">
        <div id="filter-rules-table"
             :class="{ 'hide-disabled-rules': hideDisabled }"
             hx-get="/Firewall/FilterRules/table"
             hx-trigger="load, refreshFilterRules from:body"
             hx-sync="this:replace"
             hx-swap="innerHTML"
             :hx-vals="JSON.stringify({ chain, view })">
            @await Html.PartialAsync("_LoadingOverlay", new LoadingOverlayModel { Variant = LoadingOverlayVariant.Placeholder })
        </div>
    </section>
</div>
