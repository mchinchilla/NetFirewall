@{
    ViewData["Title"] = "Firewall — Filter rules";
    Layout = "_Layout";
}

<div class="flex flex-wrap items-end justify-between gap-3 mb-6"
     style="animation: var(--animate-slide-up);"
     x-data="filterRulesPage()">
    <div>
        <p class="text-xs uppercase tracking-wider font-semibold text-surface-fg-muted">Firewall</p>
        <h1 class="text-2xl font-semibold tracking-tight">Filter rules</h1>
        <p class="text-sm mt-1 text-surface-fg-muted">
            Stateful packet filter — input / forward / output chains. Within a chain the first match wins,
            so lower priority is checked first.
        </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        @await Html.PartialAsync("_TableSearch", new TableSearchModel { TableId = "filter-rules-table", Placeholder = "Filter by action, address, port…", ClientSide = true })

        <label class="text-xs flex items-center gap-2">
            Chain
            <select x-model="chain"
                    @@change="refresh()"
                    class="input py-1 text-xs">
                <option value="">All</option>
                <option value="input">Input</option>
                <option value="forward">Forward</option>
                <option value="output">Output</option>
            </select>
        </label>

        @* View switcher. Grouping happens server-side; this only picks the mode. *@
        <div class="relative" @@click.outside="viewsOpen = false">
            <button type="button" class="btn btn-ghost text-xs gap-1.5"
                    @@click="viewsOpen = !viewsOpen"
                    :aria-expanded="viewsOpen" aria-haspopup="true">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M3.75 6h16.5M3.75 12h16.5M3.75 18h9"/>
                </svg>
                <span x-text="viewLabel"></span>
                <svg class="h-3 w-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                </svg>
            </button>

            <div x-show="viewsOpen" x-cloak x-transition.opacity.duration.120ms
                 class="absolute right-0 z-20 mt-1 w-64 rounded-md border shadow-lg overflow-hidden
                        bg-surface-elevated border-surface-border">
                <template x-for="opt in views" :key="opt.id">
                    <button type="button"
                            class="w-full text-left px-3 py-2 hover:bg-surface-muted"
                            :class="opt.id === view ? 'bg-surface-muted' : ''"
                            @@click="pick(opt.id)">
                        <span class="flex items-center gap-2 text-xs font-medium text-surface-fg">
                            <span class="h-1.5 w-1.5 rounded-full"
                                  :style="opt.id === view ? 'background-color: var(--accent);' : 'background-color: transparent;'"></span>
                            <span x-text="opt.label"></span>
                        </span>
                        <span class="block pl-3.5 text-[11px] text-surface-fg-muted" x-text="opt.hint"></span>
                    </button>
                </template>
            </div>
        </div>

        <button type="button" class="btn btn-primary"
                hx-get="/Firewall/FilterRules/edit"
                hx-target="#drawer-body" hx-swap="innerHTML"
                @@click="$store.drawer.openRaw('Add filter rule')">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
            Add rule
        </button>
    </div>

    <section class="card mt-3 w-full" style="animation: var(--animate-slide-up); animation-delay: 60ms;">
        <div id="filter-rules-table"
             hx-get="/Firewall/FilterRules/table"
             :hx-vals="JSON.stringify({ chain, view })"
             hx-trigger="load, refreshFilterRules from:body, manual-refresh"
             hx-swap="innerHTML">
            @await Html.PartialAsync("_LoadingOverlay", new LoadingOverlayModel { Variant = LoadingOverlayVariant.Placeholder })
        </div>
    </section>
</div>
