@model NetFirewall.Web.Models.Firewall.FilterRuleClusterViewModel
@using NetFirewall.Web.Models.Firewall
@{
    var primary = Model.Primary;
    var r = primary.Rule;
    var badgeCls = r.Action switch
    {
        "accept" => "badge-success",
        "drop"   => "badge-danger",
        "reject" => "badge-warning",
        _        => "badge-info"
    };
    var catchAll = primary.MatchesEverything && !Model.IsCluster;
    var srcTitle = r.SourceAddresses is { Length: > 0 } ? string.Join(", ", r.SourceAddresses) : null;
    var dstTitle = r.DestinationAddresses is { Length: > 0 } ? string.Join(", ", r.DestinationAddresses) : null;
}

@if (Model.BandLabel is not null)
{
    <div class="rule-band">@Model.BandLabel</div>
}
else if (Model.ShowGap)
{
    <div class="rule-gap" aria-hidden="true"></div>
}

<div class="rule-step"
     data-filter-row
     data-verdict="@r.Action"
     data-disabled="@(r.Enabled ? "false" : "true")"
     data-catchall="@(catchAll ? "true" : "false")">

    <div class="rule-pri">@r.Priority</div>

    <div class="rule-verdict pt-0.5">
        <span class="badge @badgeCls uppercase tracking-wide">@r.Action</span>
    </div>

    <div class="rule-body min-w-0">
        <div class="flex items-center gap-1.5 flex-wrap">
            <span class="text-sm text-surface-fg">@Model.Title</span>

            @if (!r.Enabled)
            {
                <span class="badge badge-muted" title="Disabled rules are not written into the ruleset at all.">off</span>
            }

            @if (catchAll)
            {
                <span class="badge badge-muted">matches everything</span>
            }
        </div>

        @if (primary.Chips.Count > 0)
        {
            <div class="flex items-center gap-1 flex-wrap mt-1">
                @foreach (var (label, value) in primary.Chips)
                {
                    var tip = label == "src" ? srcTitle : label == "dst" ? dstTitle : null;
                    <span class="inline-flex items-baseline gap-1 px-1.5 py-0.5 rounded text-[11px] font-mono bg-surface-muted" title="@tip">
                        <span class="text-surface-fg-muted">@label</span><span class="text-surface-fg">@value</span>
                    </span>
                }
            </div>
        }

        @if (Model.IsCluster)
        {
            <ul class="mt-1.5 space-y-1">
                @foreach (var m in Model.Members)
                {
                    <li class="flex items-center justify-between gap-2 flex-wrap">
                        <span class="text-xs font-mono text-surface-fg-muted">
                            @if (m.InterfaceIn is not null) { <span>in @m.InterfaceIn</span> }
                            @if (m.InterfaceOut is not null) { <span>out @m.InterfaceOut</span> }
                            @if (m.InterfaceIn is null && m.InterfaceOut is null) { <span>any interface</span> }
                            @if (m.ShadowedBy is { } by)
                            {
                                <span class="badge badge-warning ml-1"
                                      title="Never runs: priority @by.Priority (@(by.Description ?? by.Action)) already matches everything this rule matches.">unreachable</span>
                            }
                        </span>
                        @await Html.PartialAsync("_FilterRuleActions", m.Rule)
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="flex items-center gap-2 flex-wrap mt-1">
                @if (primary.InterfaceIn is not null || primary.InterfaceOut is not null)
                {
                    <span class="text-xs font-mono text-surface-fg-muted">
                        @if (primary.InterfaceIn is not null) { <span>in @primary.InterfaceIn</span> }
                        @if (primary.InterfaceOut is not null) { <span>out @primary.InterfaceOut</span> }
                    </span>
                }
                @if (primary.ShadowedBy is { } by)
                {
                    <span class="badge badge-warning"
                          title="Never runs: priority @by.Priority (@(by.Description ?? by.Action)) already matches everything this rule matches.">unreachable</span>
                }
            </div>
        }
    </div>

    <div class="rule-actions pt-0.5">
        @if (!Model.IsCluster)
        {
            @await Html.PartialAsync("_FilterRuleActions", r)
        }
    </div>
</div>
