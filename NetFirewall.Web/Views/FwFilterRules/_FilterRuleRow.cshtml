@model NetFirewall.Web.Models.Firewall.FilterRuleRowViewModel
@using NetFirewall.Web.Models.Firewall
@{
    var r = Model.Rule;
    var badgeCls = r.Action switch
    {
        "accept" => "badge-success",
        "drop"   => "badge-danger",
        "reject" => "badge-warning",
        _        => "badge-info"
    };
    var srcTitle = r.SourceAddresses is { Length: > 0 } ? string.Join(", ", r.SourceAddresses) : null;
    var dstTitle = r.DestinationAddresses is { Length: > 0 } ? string.Join(", ", r.DestinationAddresses) : null;
    var title = string.IsNullOrWhiteSpace(r.Description) ? "(no description)" : r.Description;
}

<tr data-disabled="@(r.Enabled ? "false" : "true")">
    <td class="pl-5 pr-2 py-2.5 font-mono text-xs tabular-nums text-surface-fg-muted">@r.Priority</td>
    <td class="px-2 py-2.5 col-chain">
        <span class="text-[11px] font-semibold uppercase tracking-wide text-surface-fg-muted">@r.Chain</span>
    </td>
    <td class="px-2 py-2.5">
        <span class="badge @badgeCls uppercase tracking-wide">@r.Action</span>
    </td>
    <td class="px-2 py-2.5" title="@srcTitle">
        <div class="flex items-center gap-1.5 flex-wrap">
            <span class="text-surface-fg">@title</span>
            @if (Model.ShadowedBy is { } by)
            {
                <span class="badge badge-warning"
                      title="Never runs: priority @by.Priority (@(by.Description ?? by.Action)) already matches everything this rule matches.">unreachable</span>
            }
            @if (Model.MatchesEverything)
            {
                <span class="text-xs text-surface-fg-muted">matches everything</span>
            }
        </div>
        @if (Model.Chips.Count > 0)
        {
            <div class="flex items-center gap-1 flex-wrap mt-1">
                @foreach (var (label, value) in Model.Chips)
                {
                    var tip = label == "src" ? srcTitle : label == "dst" ? dstTitle : null;
                    <span class="inline-flex items-baseline gap-1 px-1.5 py-0.5 rounded text-[11px] font-mono bg-surface-muted" title="@tip">
                        <span class="text-surface-fg-muted">@label</span><span class="text-surface-fg">@value</span>
                    </span>
                }
            </div>
        }
    </td>
    <td class="px-2 py-2.5">
        @if (Model.InterfaceIn is null && Model.InterfaceOut is null)
        {
            @await Html.PartialAsync("_IfaceChip", new IfaceChipViewModel { Name = "any" })
        }
        else
        {
            <div class="flex flex-wrap items-center gap-1.5">
                @if (Model.InterfaceIn is not null)
                {
                    @await Html.PartialAsync("_IfaceChip", new IfaceChipViewModel { Name = Model.InterfaceIn, Type = Model.InterfaceInType, Dir = "in" })
                }
                @if (Model.InterfaceOut is not null)
                {
                    @await Html.PartialAsync("_IfaceChip", new IfaceChipViewModel { Name = Model.InterfaceOut, Type = Model.InterfaceOutType, Dir = "out" })
                }
            </div>
        }
    </td>
    <td class="px-2 py-2.5 whitespace-nowrap">
        @if (r.Enabled)
        {
            <span class="badge badge-success">Active</span>
        }
        else
        {
            <span class="badge badge-muted" title="Disabled rules are not written into the ruleset at all.">Off</span>
        }
    </td>
    <td class="pl-2 pr-5 py-2.5 text-right whitespace-nowrap">
        @await Html.PartialAsync("_FilterRuleActions", r)
    </td>
</tr>
