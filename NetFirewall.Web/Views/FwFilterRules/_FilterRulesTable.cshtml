@model NetFirewall.Web.Models.Firewall.FilterRulesTableViewModel
@using NetFirewall.Web.Models.Firewall

@if (Model.TotalRows == 0)
{
    <div class="text-sm py-10 text-center text-surface-fg-muted">
        No filter rules in this chain. Click <span class="font-medium text-surface-fg">Add rule</span> to create one.
    </div>
}
else
{
    @if (!Model.PreservesEvaluationOrder)
    {
        @* Every non-evaluation view breaks the one property that decides what
           the firewall actually does. Say it plainly, every time. *@
        <div class="mb-3 mx-5 rounded-md border px-3 py-2 text-xs leading-relaxed
                    bg-feedback-warning-bg text-feedback-warning-fg border-feedback-warning-bd">
            Grouped for reading, <span class="font-semibold">not evaluation order</span>. The kernel walks each
            chain top to bottom and the first match wins, so switch back to
            <span class="font-semibold">Evaluation</span> before judging whether a rule can be reached.
        </div>
    }
    else if (Model.TotalShadowed > 0)
    {
        <div class="mb-3 mx-5 rounded-md border px-3 py-2 text-xs leading-relaxed
                    bg-feedback-warning-bg text-feedback-warning-fg border-feedback-warning-bd">
            <span class="font-semibold">@Model.TotalShadowed rule(s) can never run.</span>
            An earlier rule in the same chain already matches everything they match, so they are dead code —
            hover the <span class="font-semibold">unreachable</span> tag to see which one.
        </div>
    }

    <div class="overflow-x-auto -mx-5">
        <table class="min-w-full text-sm">
            @foreach (var group in Model.Groups)
            {
                <thead>
                    <tr>
                        <th colspan="6" class="px-5 pt-5 pb-2 text-left">
                            <div class="flex items-baseline gap-2 flex-wrap">
                                <span class="text-sm font-semibold uppercase tracking-wide text-surface-fg">@group.Title</span>
                                @if (group.Subtitle is not null)
                                {
                                    <span class="text-xs font-normal text-surface-fg-muted">@group.Subtitle</span>
                                }
                                <span class="text-xs font-normal text-surface-fg-muted">
                                    · @group.EnabledCount active@(group.Rows.Count > group.EnabledCount ? $", {group.Rows.Count - group.EnabledCount} off" : "")
                                </span>
                                @if (group.ShadowedCount > 0)
                                {
                                    <span class="text-xs font-medium text-feedback-warning-fg">· @group.ShadowedCount unreachable</span>
                                }
                            </div>
                        </th>
                    </tr>
                    <tr class="text-left text-[11px] uppercase tracking-wider text-surface-fg-muted border-b border-surface-border">
                        <th class="pl-5 pr-2 py-1.5 font-medium w-12">Pri</th>
                        <th class="px-2 py-1.5 font-medium w-20">Action</th>
                        <th class="px-2 py-1.5 font-medium">Rule</th>
                        <th class="px-2 py-1.5 font-medium hidden lg:table-cell w-32">Interfaces</th>
                        <th class="px-2 py-1.5 font-medium w-20">Status</th>
                        <th class="pl-2 pr-5 py-1.5 font-medium text-right w-28">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y border-surface-border">
                    @foreach (var row in group.Rows)
                    {
                        @await Html.PartialAsync("_FilterRuleRow", row)
                    }
                </tbody>
            }
        </table>
    </div>
}
