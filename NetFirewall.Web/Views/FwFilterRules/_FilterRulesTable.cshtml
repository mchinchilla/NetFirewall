@model NetFirewall.Web.Models.Firewall.FilterRulesTableViewModel
@using NetFirewall.Web.Models.Firewall

@if (Model.TotalRows == 0)
{
    <div class="text-sm py-10 text-center text-surface-fg-muted">
        No filter rules in this chain. Click <span class="font-medium text-surface-fg">Add rule</span> to create one.
    </div>
}
else
{
    @if (!Model.PreservesEvaluationOrder)
    {
        <div class="mb-3 mx-5 rounded-md border px-3 py-2 text-xs leading-relaxed
                    bg-feedback-warning-bg text-feedback-warning-fg border-feedback-warning-bd">
            Grouped for reading, <span class="font-semibold">not evaluation order</span>. The kernel walks each
            chain top to bottom and the first match wins, so switch back to
            <span class="font-semibold">Chain</span> before judging whether a rule can be reached.
        </div>
    }
    else if (Model.TotalShadowed > 0)
    {
        <div class="mb-3 mx-5 rounded-md border px-3 py-2 text-xs leading-relaxed
                    bg-feedback-warning-bg text-feedback-warning-fg border-feedback-warning-bd">
            <span class="font-semibold">@Model.TotalShadowed rule(s) can never run.</span>
            An earlier rule in the same chain already matches everything they match —
            look for the <span class="font-semibold">unreachable</span> tag.
        </div>
    }

    <div class="px-5 pb-2 text-xs text-surface-fg-muted">
        <span class="font-medium text-surface-fg">@Model.TotalEnabled</span> active
        @if (Model.TotalDisabled > 0) { <span>· @Model.TotalDisabled off</span> }
        @if (Model.TotalShadowed > 0) { <span class="text-feedback-warning-fg">· @Model.TotalShadowed unreachable</span> }
        <span>· @Model.TotalRows total</span>
    </div>

    <div class="overflow-x-auto -mx-5">
        <table class="min-w-full text-sm @(Model.PreservesEvaluationOrder ? "rule-table-eval" : "rule-table-grouped")">
            @foreach (var group in Model.Groups)
            {
                var policyCls = group.Policy switch
                {
                    "drop"   => "badge-danger",
                    "accept" => "badge-success",
                    _        => "badge-muted"
                };
                <thead>
                    <tr>
                        <th colspan="7" class="px-5 pt-5 pb-2 text-left">
                            <div class="flex items-baseline gap-2 flex-wrap">
                                @if (Model.View == FilterRuleView.Interface)
                                {
                                    var chipName = string.Equals(group.Title, "any interface", StringComparison.OrdinalIgnoreCase)
                                        ? "any" : group.Title;
                                    var chipType = string.Equals(group.Subtitle, "inbound interface", StringComparison.OrdinalIgnoreCase)
                                        ? null : group.Subtitle;
                                    @await Html.PartialAsync("_IfaceChip", new IfaceChipViewModel { Name = chipName, Type = chipType })
                                }
                                else
                                {
                                    <span class="text-sm font-semibold uppercase tracking-wide text-surface-fg">@group.Title</span>
                                }
                                @if (group.Policy is not null)
                                {
                                    <span class="badge @policyCls">policy @group.Policy</span>
                                }
                                else if (group.Subtitle is not null && Model.View != FilterRuleView.Interface)
                                {
                                    <span class="text-xs font-normal text-surface-fg-muted">@group.Subtitle</span>
                                }
                                <span class="text-xs font-normal text-surface-fg-muted">
                                    · @group.EnabledCount active@(group.DisabledCount > 0 ? $", {group.DisabledCount} off" : "")
                                </span>
                                @if (group.ShadowedCount > 0)
                                {
                                    <span class="text-xs font-medium text-feedback-warning-fg">· @group.ShadowedCount unreachable</span>
                                }
                            </div>
                            @if (group.Summary is not null)
                            {
                                <p class="text-xs font-normal mt-0.5 text-surface-fg-muted">@group.Summary</p>
                            }
                        </th>
                    </tr>
                    <tr class="text-left text-[11px] uppercase tracking-wider text-surface-fg-muted border-b border-surface-border">
                        <th class="pl-5 pr-2 py-1.5 font-medium w-12">Pri</th>
                        <th class="px-2 py-1.5 font-medium w-20 col-chain">Chain</th>
                        <th class="px-2 py-1.5 font-medium w-20">Action</th>
                        <th class="px-2 py-1.5 font-medium">Rule</th>
                        <th class="px-2 py-1.5 font-medium w-48">Interface</th>
                        <th class="px-2 py-1.5 font-medium w-20">Status</th>
                        <th class="pl-2 pr-5 py-1.5 font-medium text-right w-28">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y border-surface-border">
                    @foreach (var cluster in group.Clusters)
                    {
                        @if (cluster.BandLabel is not null)
                        {
                            <tr>
                                <td colspan="7" class="px-5 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-surface-fg-muted bg-surface-muted">
                                    @cluster.BandLabel
                                </td>
                            </tr>
                        }
                        @foreach (var row in cluster.Members)
                        {
                            @await Html.PartialAsync("_FilterRuleRow", row)
                        }
                    }
                </tbody>
            }
        </table>
    </div>
}
