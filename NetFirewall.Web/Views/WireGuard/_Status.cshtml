@model NetFirewall.Web.Models.Vpn.WgStatusViewModel
@using NetFirewall.Web.Models.Shared

@functions {
    static string FmtBytes(long b)
    {
        string[] u = ["B", "KB", "MB", "GB", "TB"];
        var i = 0; var x = (double)b;
        while (x >= 1024 && i < u.Length - 1) { x /= 1024; i++; }
        return $"{x:0.##} {u[i]}";
    }
    static string FmtAgo(DateTime? t)
    {
        if (t is null) return "—";
        var d = DateTime.UtcNow - t.Value;
        if (d.TotalSeconds < 60) return $"{(int)d.TotalSeconds}s ago";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalHours < 24)   return $"{(int)d.TotalHours}h ago";
        return $"{(int)d.TotalDays}d ago";
    }
}

@if (Model.Server is null)
{
    <div class="text-sm py-8 text-center text-surface-fg-muted">No server configured.</div>
}
else if (Model.Status.Count == 0)
{
    var upstreamDown = Model.Server.Enabled
                       && Model.Peers.Any(p => p.Enabled && string.Equals(p.Role, "upstream", StringComparison.OrdinalIgnoreCase));
    if (upstreamDown)
    {
        <div class="flex items-start gap-3 rounded-lg p-4 my-2
                    bg-feedback-danger-bg text-feedback-danger-fg border border-feedback-danger-bd">
            <svg class="h-5 w-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"/>
            </svg>
            <div class="text-sm">
                <p class="font-semibold">Tunnel @Model.Server.Name is down.</p>
                <p class="mt-0.5 opacity-90">
                    No handshake with the upstream server. The remote endpoint may be
                    unreachable or its IP may have changed — check the endpoint and click
                    <span class="font-medium">Apply VPN</span> to re-establish.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="text-sm py-6 text-center text-surface-fg-muted">
            Interface @Model.Server.Name is not up, or no peers have ever handshook.
            Click <span class="font-medium text-surface-fg">Apply VPN</span> above to bring it up.
        </div>
    }
}
else
{
    <div class="px-5 pb-2 text-xs text-surface-fg-muted">
        <span class="font-medium text-surface-fg">@Model.Status.Count</span> peer@(Model.Status.Count == 1 ? "" : "s") live
    </div>
    <div class="overflow-x-auto -mx-5">
        <table class="min-w-full text-sm">
            <thead>
                <tr class="text-left text-[11px] uppercase tracking-wider text-surface-fg-muted border-b border-surface-border">
                    <th class="pl-5 pr-2 py-1.5 font-medium">Peer</th>
                    <th class="px-2 py-1.5 font-medium hidden md:table-cell">Endpoint</th>
                    <th class="px-2 py-1.5 font-medium">Handshake</th>
                    <th class="px-2 py-1.5 font-medium">Traffic</th>
                    <th class="pl-2 pr-5 py-1.5 font-medium w-24">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y border-surface-border">
                @{ var byPubkey = Model.Peers.ToDictionary(p => p.PublicKey, p => p); }
                @foreach (var s in Model.Status.OrderByDescending(s => s.LastHandshakeAt ?? DateTime.MinValue))
                {
                    var peer = byPubkey.TryGetValue(s.PublicKey, out var p) ? p : null;
                    var name = peer?.Name ?? "(unknown)";
                    var health = NetFirewall.Models.Vpn.WgPeerHealthEvaluator.Evaluate(
                        peer, s, DateTime.UtcNow);
                    var (badgeCls, statusLabel) = health switch
                    {
                        NetFirewall.Models.Vpn.WgPeerHealth.Connected => ("badge-success", "Connected"),
                        NetFirewall.Models.Vpn.WgPeerHealth.Pending   => ("badge-warning", "Pending"),
                        NetFirewall.Models.Vpn.WgPeerHealth.Down      => ("badge-danger",  "Down"),
                        _                                             => ("badge-muted",   "Idle"),
                    };
                    var shortKey = s.PublicKey.Length > 16 ? s.PublicKey[..16] + "…" : s.PublicKey;
                    <tr>
                        <td class="pl-5 pr-2 py-2.5">
                            <div class="font-medium text-surface-fg">@name</div>
                            <div class="mt-1">
                                @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "key", Value = shortKey, Title = s.PublicKey })
                            </div>
                        </td>
                        <td class="px-2 py-2.5 hidden md:table-cell">
                            @if (string.IsNullOrEmpty(s.Endpoint))
                            {
                                <span class="text-xs text-surface-fg-muted">—</span>
                            }
                            else
                            {
                                @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "ep", Value = s.Endpoint, Title = s.Endpoint })
                            }
                        </td>
                        <td class="px-2 py-2.5 text-xs text-surface-fg-muted">@FmtAgo(s.LastHandshakeAt)</td>
                        <td class="px-2 py-2.5">
                            <div class="flex items-center gap-1 flex-wrap">
                                @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "rx", Value = FmtBytes(s.RxBytes) })
                                @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "tx", Value = FmtBytes(s.TxBytes) })
                            </div>
                        </td>
                        <td class="pl-2 pr-5 py-2.5 whitespace-nowrap">
                            <span class="badge @badgeCls">@statusLabel</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
