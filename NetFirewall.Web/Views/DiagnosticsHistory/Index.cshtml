@model NetFirewall.Web.Models.Diagnostics.HistoryFilterViewModel
@using NetFirewall.Web.Models.Diagnostics
@{
    ViewData["Title"] = "Diagnostics history";
    Layout = "_Layout";
    var isAdmin = User.IsInRole(NetFirewall.Models.Auth.UserRoles.Admin);
}
@await Html.PartialAsync("_ToolPageHeader", new ToolPageHeaderViewModel("History",
    "Every diagnostic run: who, when, with what, and what came back. Filter, group or search in the grid; expand a row for its parameters and raw result. Rows are pruned after the retention period set in Settings → Diagnostics."))

<div class="space-y-4"
     x-init="@(Model.Run is { } run ? $"$store.drawer.openUrl({{ title: 'Diagnostic run', url: '/Diagnostics/History/{run}' }})" : "")">
    @if (isAdmin)
    {
        <div class="flex justify-end" style="animation: var(--animate-slide-up);">
            <button type="button" class="btn btn-ghost text-xs text-feedback-danger-fg"
                    hx-post="/Diagnostics/History/purge" hx-vals='{"olderThanDays": 0}' hx-trigger="confirmed-purge" hx-swap="none"
                    @@click.prevent="(async () => {
                        const ok = await $store.confirm.ask({
                            title: 'Purge all diagnostics history?',
                            message: 'Deletes every recorded run. Audit log keeps a diag.purge entry.',
                            confirmLabel: 'Purge everything', level: 'danger' });
                        if (ok) htmx.trigger($el, 'confirmed-purge');
                    })()">Purge all</button>
        </div>
    }

    <section style="animation: var(--animate-slide-up); animation-delay: 60ms;">
        @await Html.PartialAsync("_Grid", new GridFrameViewModel
        {
            GridId = NetFirewall.Web.Grids.Diagnostics.DiagnosticsHistoryGrid.Id,
            Title = "Diagnostics history",
            DefaultQuery = NetFirewall.Web.Grids.Diagnostics.DiagnosticsHistoryGrid.DefaultQuery,
            RefreshOn = ["refreshDiagHistory"],
            ForwardQuery = false
        })
    </section>
</div>
