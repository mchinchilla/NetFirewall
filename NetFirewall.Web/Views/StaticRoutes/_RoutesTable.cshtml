@model IReadOnlyList<NetFirewall.Web.Models.Network.StaticRouteRowViewModel>
@using NetFirewall.Web.Models.Firewall
@using NetFirewall.Web.Models.Shared

@if (Model.Count == 0)
{
    <div class="text-sm py-10 text-center text-surface-fg-muted">
        No static routes yet. Click <span class="font-medium text-surface-fg">Add route</span> to create one.
    </div>
}
else
{
    var enabled = Model.Count(r => r.Route.Enabled);
    var disabled = Model.Count - enabled;
    var grouped = Model.GroupBy(r => r.InterfaceName).OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase);
    <div class="px-5 pb-2 text-xs text-surface-fg-muted">
        <span class="font-medium text-surface-fg">@enabled</span> active
        @if (disabled > 0) { <span>· @disabled off</span> }
        <span>· @Model.Count total</span>
    </div>
    <div class="overflow-x-auto -mx-5">
        <table class="min-w-full text-sm">
            @foreach (var group in grouped)
            {
                var gEnabled = group.Count(x => x.Route.Enabled);
                var gOff = group.Count() - gEnabled;
                var gType = group.First().InterfaceType;
                <thead>
                    <tr>
                        <th colspan="5" class="px-5 pt-5 pb-2 text-left">
                            <div class="flex items-baseline gap-2 flex-wrap">
                                @await Html.PartialAsync("_IfaceChip", new IfaceChipViewModel { Name = group.Key, Type = gType })
                                <span class="text-xs font-normal text-surface-fg-muted">
                                    · @gEnabled active@(gOff > 0 ? $", {gOff} off" : "")
                                </span>
                            </div>
                        </th>
                    </tr>
                    <tr class="text-left text-[11px] uppercase tracking-wider text-surface-fg-muted border-b border-surface-border">
                        <th class="pl-5 pr-2 py-1.5 font-medium">Route</th>
                        <th class="px-2 py-1.5 font-medium hidden md:table-cell w-16">Metric</th>
                        <th class="px-2 py-1.5 font-medium hidden lg:table-cell">Description</th>
                        <th class="px-2 py-1.5 font-medium w-20">Status</th>
                        <th class="pl-2 pr-5 py-1.5 font-medium text-right w-40">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y border-surface-border">
                    @foreach (var row in group)
                    {
                        var via = row.Route.Gateway?.ToString() ?? "direct";
                        <tr data-disabled="@(row.Route.Enabled ? "false" : "true")">
                            <td class="pl-5 pr-2 py-2.5">
                                <div class="flex items-center gap-1 flex-wrap">
                                    @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "dst", Value = row.Route.Destination, Title = row.Route.Destination })
                                    @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "via", Value = via })
                                </div>
                            </td>
                            <td class="px-2 py-2.5 hidden md:table-cell font-mono text-xs tabular-nums text-surface-fg-muted">@row.Route.Metric</td>
                            <td class="px-2 py-2.5 hidden lg:table-cell text-xs text-surface-fg-muted">
                                @(row.Route.Description ?? "—")
                            </td>
                            <td class="px-2 py-2.5 whitespace-nowrap">
                                @if (row.Route.Enabled)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-muted">Off</span>
                                }
                            </td>
                            <td class="pl-2 pr-5 py-2.5 text-right whitespace-nowrap">
                                <div class="inline-flex items-center gap-1">
                                    <button type="button" class="btn btn-ghost text-xs"
                                            hx-post="/Network/Routes/apply/@row.Route.Id"
                                            hx-trigger="confirmed-apply"
                                            @@click.prevent="(async () => {
                                                const ok = await $store.confirm.ask({
                                                    title: 'Apply route?',
                                                    message: 'Regenerates the interface config and live-adds the route via ip route.',
                                                    confirmLabel: 'Apply',
                                                    level: 'warning'
                                                });
                                                if (ok) htmx.trigger($el, 'confirmed-apply');
                                            })()">Apply</button>
                                    @await Html.PartialAsync("_RowActions", new RowActionsViewModel
                                    {
                                        EditUrl = $"/Network/Routes/edit/{row.Route.Id}",
                                        EditDrawerTitle = "Edit route",
                                        DeleteUrl = $"/Network/Routes/delete/{row.Route.Id}",
                                        DeleteDialogTitle = "Delete route?",
                                        DeleteMessage = $"{row.Route.Destination} via {via} on {row.InterfaceName}"
                                    })
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            }
        </table>
    </div>
}
