@model IReadOnlyList<NetFirewall.Models.Dhcp.DhcpClass>
@using NetFirewall.Web.Models.Shared

@if (Model.Count == 0)
{
    <div class="text-sm py-10 text-center text-surface-fg-muted">
        No classes yet. Click <span class="font-medium text-surface-fg">Add class</span> to start steering specific client groups.
    </div>
}
else
{
    var enabled = Model.Count(c => c.Enabled);
    var disabled = Model.Count - enabled;
    var grouped = Model.OrderBy(x => x.Priority).ThenBy(x => x.Name)
        .GroupBy(c => string.IsNullOrWhiteSpace(c.MatchType) ? "other" : c.MatchType.Replace('_', ' '));
    <div class="px-5 pb-2 text-xs text-surface-fg-muted">
        <span class="font-medium text-surface-fg">@enabled</span> active
        @if (disabled > 0) { <span>· @disabled off</span> }
        <span>· @Model.Count total</span>
    </div>
    <div class="overflow-x-auto -mx-5">
        <table class="min-w-full text-sm">
            @foreach (var group in grouped)
            {
                var gEnabled = group.Count(x => x.Enabled);
                var gOff = group.Count() - gEnabled;
                <thead>
                    <tr>
                        <th colspan="5" class="px-5 pt-5 pb-2 text-left">
                            <div class="flex items-baseline gap-2 flex-wrap">
                                <span class="text-sm font-semibold uppercase tracking-wide text-surface-fg">@group.Key</span>
                                <span class="text-xs font-normal text-surface-fg-muted">
                                    · @gEnabled active@(gOff > 0 ? $", {gOff} off" : "")
                                </span>
                            </div>
                        </th>
                    </tr>
                    <tr class="text-left text-[11px] uppercase tracking-wider text-surface-fg-muted border-b border-surface-border">
                        <th class="pl-5 pr-2 py-1.5 font-medium w-12">Pri</th>
                        <th class="px-2 py-1.5 font-medium">Class</th>
                        <th class="px-2 py-1.5 font-medium hidden md:table-cell">Boot</th>
                        <th class="px-2 py-1.5 font-medium w-20">Status</th>
                        <th class="pl-2 pr-5 py-1.5 font-medium text-right w-28">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y border-surface-border">
                    @foreach (var c in group)
                    {
                        <tr data-disabled="@(c.Enabled ? "false" : "true")">
                            <td class="pl-5 pr-2 py-2.5 font-mono text-xs tabular-nums text-surface-fg-muted">@c.Priority</td>
                            <td class="px-2 py-2.5">
                                <div class="font-medium text-surface-fg">@c.Name</div>
                                <div class="flex items-center gap-1 flex-wrap mt-1">
                                    @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "match", Value = c.MatchType })
                                    @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "val", Value = c.MatchValue, Title = c.MatchValue })
                                </div>
                            </td>
                            <td class="px-2 py-2.5 hidden md:table-cell">
                                @if (c.NextServer != null || !string.IsNullOrEmpty(c.BootFilename))
                                {
                                    <div class="flex items-center gap-1 flex-wrap">
                                        @if (c.NextServer is not null)
                                        {
                                            @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "tftp", Value = c.NextServer.ToString() })
                                        }
                                        @if (!string.IsNullOrEmpty(c.BootFilename))
                                        {
                                            @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "file", Value = c.BootFilename, Title = c.BootFilename })
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-surface-fg-muted">—</span>
                                }
                            </td>
                            <td class="px-2 py-2.5 whitespace-nowrap">
                                @if (c.Enabled)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-muted">Off</span>
                                }
                            </td>
                            <td class="pl-2 pr-5 py-2.5 text-right whitespace-nowrap">
                                @await Html.PartialAsync("_RowActions", new RowActionsViewModel
                                {
                                    EditUrl = $"/Dhcp/Classes/edit/{c.Id}",
                                    EditDrawerTitle = $"Edit {c.Name}",
                                    DeleteUrl = $"/Dhcp/Classes/delete/{c.Id}",
                                    DeleteDialogTitle = "Delete class?",
                                    DeleteMessage = $"Delete class '{c.Name}'? Pool↔class associations are cascaded."
                                })
                            </td>
                        </tr>
                    }
                </tbody>
            }
        </table>
    </div>
}
