@{
    ViewData["Title"] = "DHCP — Classes";
    Layout = "_Layout";
}

<div>
    <div class="flex flex-wrap items-end justify-between gap-3 mb-4"
         style="animation: var(--animate-slide-up);">
        <div>
            <p class="page-kicker">DHCP</p>
            <h1 class="text-2xl font-semibold tracking-tight">Client classes</h1>
            <p class="text-sm mt-1 max-w-2xl text-surface-fg-muted">
                Classify clients by vendor / user / MAC prefix / option to override TFTP server, boot file, and pool eligibility.
                Classic use: PXE booting different architectures (BIOS vs UEFI).
                Classes are evaluated top to bottom by priority (lowest first).
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-primary"
                    hx-get="/Dhcp/Classes/edit"
                    hx-target="#drawer-body" hx-swap="innerHTML"
                    @@click="$store.drawer.openRaw('Add class')">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                Add class
            </button>
        </div>
    </div>

    <section style="animation: var(--animate-slide-up); animation-delay: 60ms;">
        @await Html.PartialAsync("_Grid", new GridFrameViewModel
        {
            GridId = NetFirewall.Web.Grids.Dhcp.DhcpClassesGrid.Id,
            Title = "DHCP client classes",
            DefaultQuery = NetFirewall.Web.Grids.Dhcp.DhcpClassesGrid.DefaultQuery,
            RefreshOn = ["refreshClasses"]
        })
    </section>
</div>
