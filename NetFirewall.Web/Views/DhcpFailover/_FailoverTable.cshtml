@model IReadOnlyList<NetFirewall.Models.Dhcp.FailoverPeer>
@using NetFirewall.Web.Models.Shared

@if (Model.Count == 0)
{
    <div class="text-sm py-10 text-center text-surface-fg-muted">
        No failover peers configured. Click <span class="font-medium text-surface-fg">Add peer</span> to enable HA — until then the server runs standalone.
    </div>
}
else
{
    var enabled = Model.Count(p => p.Enabled);
    var disabled = Model.Count - enabled;
    <div class="px-5 pb-2 text-xs text-surface-fg-muted">
        <span class="font-medium text-surface-fg">@enabled</span> active
        @if (disabled > 0) { <span>· @disabled off</span> }
        <span>· @Model.Count total</span>
    </div>
    <div class="overflow-x-auto -mx-5">
        <table class="min-w-full text-sm">
            <thead>
                <tr class="text-left text-[11px] uppercase tracking-wider text-surface-fg-muted border-b border-surface-border">
                    <th class="pl-5 pr-2 py-1.5 font-medium">Peer</th>
                    <th class="px-2 py-1.5 font-medium">Role</th>
                    <th class="px-2 py-1.5 font-medium hidden md:table-cell">Split / MCLT</th>
                    <th class="px-2 py-1.5 font-medium w-20">Status</th>
                    <th class="pl-2 pr-5 py-1.5 font-medium text-right w-28">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y border-surface-border">
                @foreach (var p in Model.OrderBy(x => x.Name))
                {
                    <tr data-disabled="@(p.Enabled ? "false" : "true")">
                        <td class="pl-5 pr-2 py-2.5">
                            <div class="font-medium text-surface-fg">@p.Name</div>
                            <div class="flex items-center gap-1 flex-wrap mt-1">
                                @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "peer", Value = $"{p.PeerAddress}:{p.PeerPort}" })
                            </div>
                        </td>
                        <td class="px-2 py-2.5 whitespace-nowrap">
                            <span class="badge badge-accent uppercase tracking-wide">@p.Role</span>
                        </td>
                        <td class="px-2 py-2.5 hidden md:table-cell">
                            <div class="flex items-center gap-1 flex-wrap">
                                @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "split", Value = p.Split.ToString() })
                                @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "mclt", Value = $"{p.Mclt / 60}m" })
                            </div>
                        </td>
                        <td class="px-2 py-2.5 whitespace-nowrap">
                            @if (p.Enabled)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-muted">Off</span>
                            }
                        </td>
                        <td class="pl-2 pr-5 py-2.5 text-right whitespace-nowrap">
                            @await Html.PartialAsync("_RowActions", new RowActionsViewModel
                            {
                                EditUrl = $"/Dhcp/Failover/edit/{p.Id}",
                                EditDrawerTitle = $"Edit {p.Name}",
                                DeleteUrl = $"/Dhcp/Failover/delete/{p.Id}",
                                DeleteDialogTitle = "Delete peer?",
                                DeleteMessage = $"Delete failover peer '{p.Name}'? The DHCP server will fall back to standalone on next start."
                            })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
