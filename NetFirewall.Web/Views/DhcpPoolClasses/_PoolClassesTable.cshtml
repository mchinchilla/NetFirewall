@model IReadOnlyList<NetFirewall.Models.Dhcp.DhcpClass>
@using NetFirewall.Web.Models.Shared
@{
    var bindings = (IDictionary<Guid, bool>)(ViewBag.Bindings ?? new Dictionary<Guid, bool>());
    var poolId = (Guid)ViewBag.PoolId;
}

@if (Model.Count == 0)
{
    <div class="text-sm py-10 text-center text-surface-fg-muted">
        No client classes defined yet. Create some under
        <a class="hover:underline text-accent" href="@Url.Action("Index", "DhcpClasses")">DHCP → Classes</a>
        first.
    </div>
}
else
{
    <div class="px-5 pb-2 text-xs text-surface-fg-muted">
        <span class="font-medium text-surface-fg">@Model.Count</span> class@(Model.Count == 1 ? "" : "es")
    </div>
    <div class="overflow-x-auto -mx-5">
        <table class="min-w-full text-sm">
            <thead>
                <tr class="text-left text-[11px] uppercase tracking-wider text-surface-fg-muted border-b border-surface-border">
                    <th class="pl-5 pr-2 py-1.5 font-medium">Class</th>
                    <th class="px-2 py-1.5 font-medium hidden md:table-cell">Match</th>
                    <th class="px-2 py-1.5 font-medium w-24">Binding</th>
                    <th class="pl-2 pr-5 py-1.5 font-medium text-right w-40">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y border-surface-border">
                @foreach (var c in Model.OrderBy(x => x.Priority).ThenBy(x => x.Name))
                {
                    var hasBinding = bindings.TryGetValue(c.Id, out var allow);
                    var badgeCls = !hasBinding ? "badge-muted" : allow ? "badge-success" : "badge-danger";
                    var label = !hasBinding ? "unbound" : allow ? "allowed" : "denied";
                    <tr>
                        <td class="pl-5 pr-2 py-2.5">
                            <div class="font-medium text-surface-fg">@c.Name</div>
                            <p class="text-xs text-surface-fg-muted">priority @c.Priority@(c.Enabled ? "" : " · off")</p>
                        </td>
                        <td class="px-2 py-2.5 hidden md:table-cell">
                            <div class="flex items-center gap-1 flex-wrap">
                                @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "match", Value = c.MatchType })
                                @await Html.PartialAsync("_RuleChip", new RuleChipViewModel { Label = "val", Value = c.MatchValue, Title = c.MatchValue })
                            </div>
                        </td>
                        <td class="px-2 py-2.5 whitespace-nowrap">
                            <span class="badge @badgeCls">@label</span>
                        </td>
                        <td class="pl-2 pr-5 py-2.5 text-right whitespace-nowrap">
                            <form class="inline-flex items-center gap-1"
                                  hx-post="/Dhcp/Subnets/@ViewBag.SubnetId/Pools/@poolId/Classes/set"
                                  hx-swap="none">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="classId" value="@c.Id" />
                                <button type="submit" name="mode" value="allow"
                                        class="btn btn-ghost text-xs @(hasBinding && allow ? "text-feedback-success-fg font-semibold" : "")">Allow</button>
                                <button type="submit" name="mode" value="deny"
                                        class="btn btn-ghost text-xs @(hasBinding && !allow ? "text-feedback-danger-fg font-semibold" : "")">Deny</button>
                                @if (hasBinding)
                                {
                                    <button type="submit" name="mode" value="remove"
                                            class="btn btn-ghost text-xs text-surface-fg-muted">Unbind</button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
